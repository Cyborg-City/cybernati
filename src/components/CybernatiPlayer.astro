---
import { getBaseUrl } from '@/utils/url-helpers';
const base = getBaseUrl();
---

<div id="global-cyber-player" class="is-hidden not-prose">
  <!-- Invisible Resize Handles for PiP -->
  <div class="pip-resizer pip-resizer-t" data-direction="t"></div>
  <div class="pip-resizer pip-resizer-r" data-direction="r"></div>
  <div class="pip-resizer pip-resizer-b" data-direction="b"></div>
  <div class="pip-resizer pip-resizer-l" data-direction="l"></div>
  <div class="pip-resizer pip-resizer-tl" data-direction="tl"></div>
  <div class="pip-resizer pip-resizer-tr" data-direction="tr"></div>
  <div class="pip-resizer pip-resizer-bl" data-direction="bl"></div>
  <div class="pip-resizer pip-resizer-br" data-direction="br">
  </div>
  
  <div id="player-root" class="relative flex h-full w-full flex-col p-2.5 box-sizing-border-box">
    
    <!-- Top Header: Dynamic playing title & Cybernati branding -->
    <div class="cyber-header glass-panel mb-2 flex flex-shrink-0 items-center justify-between rounded-lg px-2.5 py-1 shadow-md">
      <div class="flex items-center">
        <div id="video-title" class="text-xs font-bold tracking-wider text-zinc-400 uppercase truncate max-w-[280px] sm:max-w-[420px] m-0 p-0 leading-none" style="font-family: var(--font-mono)">
          SCANNING FOR SIGNAL...
        </div>
      </div>
      <div class="flex items-center gap-2">
        <a href={base} target="_top" class="text-xs font-bold tracking-widest text-highlight-400 hover:text-highlight-300 transition-colors m-0 p-0 leading-none" style="font-family: 'Special Elite', cursive;">CYBERNATI™</a>
      </div>
    </div>

    <!-- Main Viewport: The YouTube Video player -->
    <div id="player-viewport" class="cyber-main relative flex-grow min-h-0 rounded-2xl border border-zinc-900 bg-black overflow-hidden shadow-2xl">
      <div id="player-mount" class="h-full w-full">
        <!-- Standby Signal message during initialization -->
        <div id="terminal-status-msg" class="flex h-full w-full flex-col items-center justify-center gap-3 bg-zinc-950 text-center">
          <!-- TO REVERT TO ORIGINAL CIRCULAR SPINNER: Comment out the .cyber-logo-loader block below, and uncomment the standard spinner.
          <svg class="w-8 h-8 text-highlight-400 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" opacity="0.25"/>
            <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          -->
          <svg class="cyber-logo-loader" viewBox="0 0 59 70" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <g>
              <path d="M30.195,0.042c2.185,1.277 6.06,3.872 9.96,6.331c1.687,1.064 0.754,1.507 -0.073,3.295c-1.991,4.306 -2.263,5.581 -3.219,4.996c-5.876,-3.597 -6.506,-4.602 -7.785,-3.897c-1.28,0.705 -10.531,5.804 -15.897,8.994c-1.24,0.737 -1.276,0.63 -3.057,1.712c-1.501,0.912 -1.112,1.272 -1.123,4.622c-0.005,1.61 -0.064,19.884 -0.047,20.122c0.066,0.905 0.454,0.705 11.226,7.44c0.73,0.457 8.123,5.079 9.208,5.579c1.257,0.579 8.786,-5.825 7.204,-3.238c-7.844,12.829 -7.792,13.291 -8.329,13.037c-0.18,-0.085 -19.139,-11.851 -27.391,-16.749c-1.118,-0.664 -0.849,-0.98 -0.832,-10.538c0.017,-7.546 0.033,-15.092 0.05,-22.639c0.005,-1.743 -0.418,-2.095 1.082,-2.959c2.284,-1.315 27.992,-16.114 28.713,-16.15c0.104,-0.005 0.206,0.047 0.31,0.042Z" fill="currentColor"/>
              <path d="M40.494,28.353c0.466,0.656 0.409,0.703 0.455,11.158c0.006,1.369 0.282,1.563 -0.786,2.412c-7.967,4.888 -8.734,4.5 -8.752,6.253c-0.042,3.988 0.52,5.291 -1.204,5.965c-0.037,0.015 -1.795,0.218 -1.791,-1.493c0.01,-5.057 0.336,-5.423 -1.118,-6.298c-1.013,-0.609 -2.682,-1.597 -6.428,-3.914c-1.069,-0.661 -1.994,-0.836 -1.998,-2.084c-0.041,-11.892 0.086,-11.962 0.436,-12.249c1.696,-1.39 9.058,-4.887 9.103,-5.926c0.242,-5.565 -0.572,-6.268 1.177,-6.793c0.407,-0.122 1.758,0.521 1.81,1.194c0.178,2.303 -0.415,5.803 0.48,6.4c2.326,1.551 3.205,1.843 8.618,5.376Zm-3.038,1.631c-6.908,-4.327 -6.853,-4.522 -7.558,-4.551c-0.555,-0.023 -7.7,4.482 -7.806,4.598c-0.504,0.553 -0.221,8.203 -0.195,8.916c0.012,0.329 0.027,0.732 3.227,2.551c4.499,2.558 4.584,3.13 5.577,2.442c3.059,-2.12 7.187,-3.377 7.19,-4.987c0.016,-8.59 -0.104,-8.63 -0.435,-8.969Z" fill="currentColor"/>
              <path d="M32.754,66.103c0.619,-1.101 2.181,-3.683 2.374,-4.002c4.074,-6.737 4.293,-8.116 6.551,-9.363c2.438,-1.346 7.588,-4.514 8.309,-4.902c0.857,-0.461 3.16,1.74 8.334,4.648c0.834,0.469 0.047,0.736 -3.594,2.888c-21.648,12.795 -21.535,12.931 -23.45,13.981c-1.065,0.584 0.642,-1.825 1.476,-3.251Z" fill="currentColor"/>
              <path d="M40.908,21.114c-0.341,1.197 0.385,0.993 4.834,3.983c1.481,0.995 -0.337,6.845 1.177,7.216c0.074,0.018 1.706,0.033 1.712,1.05c0.023,3.922 0.105,4.442 -0.543,4.584c-1.267,0.279 -1.78,-0.007 -1.792,1.286c-0.041,4.772 0.302,5.447 -0.772,6.117c-3.663,2.289 -5.039,2.671 -4.818,3.408c0.361,1.2 0.849,1.5 -0.252,2.108c-3.438,1.9 -3.622,2.29 -4.05,1.712c-0.728,-0.984 -0.76,-1.496 -1.829,-0.899c-0.055,0.03 -0.74,0.413 -0.767,-0.151c-0.107,-2.283 -0.394,-2.683 1.597,-3.768c0.639,-0.348 7.122,-3.883 7.779,-4.71c0.314,-0.395 0.184,-15.577 0.053,-15.803c-0.529,-0.911 -9.396,-5.422 -9.448,-6.46c-0.009,-0.186 -0.382,-3.005 0.602,-2.598c0.73,0.301 1.084,0.89 1.82,-0.265c0.716,-1.124 1.268,-0.404 4.074,1.383c0.944,0.601 0.983,0.754 0.622,1.807Z" fill="currentColor"/>
              <path d="M42.211,9.616c0.477,-1.049 0.477,-1.049 0.547,-1.121c0.179,-0.182 0.38,-0.335 6.926,3.989c7.953,5.254 9.931,5.431 8.241,6.472c-6.909,4.253 -6.923,4.355 -7.617,4.273c-0.44,-0.052 -8.332,-5.201 -9.047,-5.668c-1.445,-0.943 -2.451,-0.965 -1.765,-2.315c1.124,-2.211 2.504,-5.177 2.715,-5.63Z" fill="currentColor"/>
              <path d="M16.5,41.189c0.024,0.622 -0.77,1.304 2.248,3.012c0.594,0.336 7.027,3.977 7.232,4.534c0.014,0.038 0.556,3.676 -0.613,2.91c-1.823,-1.195 -1.508,0.86 -2.473,0.926c-0.325,0.022 -0.331,-0.021 -3.539,-2.014c-0.865,-0.537 -0.943,-0.7 -0.49,-1.612c0.63,-1.268 -0.318,-1.104 -4.545,-3.957c-1.746,-1.178 -0.851,-1.674 -0.966,-6.593c-0.042,-1.79 -2.218,-0.475 -2.242,-1.955c-0.023,-1.399 0.601,-1.019 2.01,-0.983c2.659,0.066 3.099,0.062 3.237,0.227c0.184,0.22 0.138,1.56 0.141,5.505Z" fill="currentColor"/>
              <path d="M16.505,27.494c0.011,5.459 0.181,6.079 -0.59,6.092c-4.404,0.075 -4.472,0.043 -4.702,-0.255c-0.105,-0.136 -0.297,-1.254 0.275,-1.554c0.547,-0.288 1.838,-0.116 1.853,-1.209c0.054,-3.723 -0.13,-5.424 0.395,-5.797c1.501,-1.065 5.613,-2.848 5.307,-3.719c-0.098,-0.279 -0.253,-0.536 -0.369,-0.808c-0.421,-0.987 1.488,-1.662 2.202,-2.095c1.514,-0.919 1.468,-1.459 2.32,-1.012c0.558,0.293 0.257,1.885 1.874,1.002c0.611,-0.334 0.969,-0.591 0.983,0.119c0.043,2.263 0.263,2.613 -1.263,3.517c-8.074,4.783 -8.187,4.87 -8.287,5.719Z" fill="currentColor"/>
              <path d="M35.632,34.294c0.221,0.472 0.207,0.472 0.067,0.987c-5.551,7.12 -12.666,0.411 -11.582,-1.014c0.972,-1.278 5.945,-6.322 11.515,0.027Zm-5.93,-0.643c0.01,0.134 0.133,1.749 1.383,0.959c0.021,-0.013 1.289,-1.655 1.084,0.151c-0.439,3.864 -6.013,1.476 -4.183,-1.373c0.034,-0.054 1.644,-1.558 0.235,-1.116c-0.823,0.258 -3.807,2.073 -2.964,2.957c0.499,0.523 4.613,4.835 9.028,0.297c1.396,-1.435 -3.336,-4.023 -4.084,-2.987c-0.268,0.371 -0.469,1.019 -0.498,1.112Z" fill="currentColor"/>
            </g>
          </svg>
          <span class="text-xs uppercase tracking-widest text-zinc-400 mt-1" style="font-family: var(--font-mono)">Aligning Remote Feed Nodes...</span>
        </div>
      </div>

      <!-- Transparent overlay to intercept user clicks. -->
      <div id="player-click-overlay" class="absolute inset-0 z-20 cursor-pointer"></div>

      <!-- Sync Progress Bar -->
      <div id="progress-container" class="absolute bottom-0 left-0 w-full h-1 bg-zinc-950/80 z-20" aria-label="Media play progress">
        <div id="sync-progress" class="progress-bar-fill h-full w-0"></div>
      </div>

      <!-- PiP Hover Header Overlay -->
      <div id="pip-header-overlay" class="absolute top-3 left-3 right-3 z-30 flex items-center justify-between rounded-lg border border-zinc-800 bg-zinc-950/90 backdrop-blur-md px-2.5 py-1.5 opacity-0 pointer-events-none transition-all duration-300 shadow-xl border border-white/5 select-none">
        <div id="pip-video-title" class="text-xs font-bold tracking-wider text-zinc-200 uppercase truncate m-0 p-0 leading-none" style="font-family: var(--font-mono)">
          SCANNING FOR SIGNAL...
        </div>
      </div>      <!-- PiP Hover Controls Overlay -->
      <div id="pip-controls-overlay" class="absolute bottom-3 left-3 z-30 flex items-center justify-center gap-2.5 rounded-lg border border-zinc-800 bg-zinc-950/90 backdrop-blur-md px-2.5 py-1.5 opacity-0 pointer-events-none transition-all duration-300 shadow-xl border border-white/5 w-auto">
        <div class="flex items-center gap-1.5">
          <button id="pip-mute-toggle" class="flex items-center justify-center rounded p-1 text-zinc-400 hover:bg-zinc-800 hover:text-highlight-400" aria-label="Toggle mute state">
            <span id="pip-volume-icon-symbol" class="material-symbols-outlined text-base">volume_off</span>
          </button>
          <input type="range" id="pip-volume-control" class="h-1 w-14 cursor-pointer accent-highlight-500 bg-zinc-800 rounded-lg appearance-none" min="0" max="100" value="0" aria-label="Volume Slider" />
        </div>
        
        <!-- PiP Related Button -->
        <button id="pip-notes-btn" class="flex items-center justify-center rounded p-1 text-zinc-400 hover:bg-zinc-800 hover:text-highlight-400 transition-colors" title="Related" aria-label="Related">
          <span class="material-symbols-outlined text-base">menu_book</span>
        </button>

        <!-- PiP Fullscreen Button -->
        <button id="pip-fullscreen-btn" class="flex items-center justify-center rounded p-1 text-zinc-400 hover:bg-zinc-800 hover:text-highlight-400 transition-colors" title="Toggle Fullscreen" aria-label="Toggle Fullscreen">
          <span class="material-symbols-outlined text-base">fullscreen</span>
        </button>

        <!-- PiP Return Button -->
        <button id="pip-return-btn" class="flex items-center justify-center rounded p-1 text-zinc-400 hover:bg-zinc-800 hover:text-highlight-400 transition-colors hidden" title="Return to Page" aria-label="Return to Page">
          <span class="material-symbols-outlined text-base">pip_exit</span>
        </button>

        <!-- PiP Exit Button -->
        <button id="pip-exit-btn" class="flex items-center justify-center rounded p-1 text-zinc-400 hover:bg-zinc-800 hover:text-red-400 transition-colors" title="Close Player" aria-label="Close Player">
          <span class="material-symbols-outlined text-base">close</span>
        </button>
      </div>

      <!-- PiP Hover Related Panel Overlay -->
      <div id="pip-notes-panel" class="absolute bottom-14 left-3 right-3 z-30 rounded-lg border border-zinc-800 bg-zinc-950/60 backdrop-blur-lg px-3 py-2.5 opacity-0 pointer-events-none transition-all duration-300 shadow-xl border border-white/5 max-h-0 overflow-hidden">
        <div class="flex flex-col gap-1.5">
          <div class="text-[9px] uppercase tracking-wider text-zinc-500 font-bold" style="font-family: var(--font-mono)">Related</div>
          <div id="pip-related-links" class="flex flex-wrap gap-1.5 max-h-[80px] overflow-y-auto custom-scroll text-zinc-300 pr-1">
            <span class="text-[10px] text-zinc-500 uppercase italic">No related notes detected.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Collapsible Related overlay -->
    <div id="related-notes-panel" class="absolute bottom-[92px] left-4 right-4 z-50 rounded-2xl glass-panel shadow-2xl max-h-0 overflow-hidden transition-all duration-300 ease-in-out opacity-0">
      <div class="p-4">
        <div id="related-links" class="flex flex-wrap gap-2 max-h-[160px] overflow-y-auto custom-scroll pr-1 text-zinc-300">
          <span class="text-xs text-zinc-500 uppercase italic">No related notes detected.</span>
        </div>
      </div>
    </div>

    <!-- Collapsible Share Panel overlay -->
    <div id="share-panel" class="absolute bottom-[92px] left-4 right-4 z-50 rounded-2xl glass-panel shadow-2xl max-h-0 overflow-hidden transition-all duration-300 ease-in-out opacity-0">
      <div class="p-4 flex flex-col gap-3">
        <div class="flex flex-col gap-3"> <!-- Share Link -->
          <div class="flex flex-col gap-1">
            <label class="text-[9px] uppercase tracking-wider text-zinc-500 font-bold" style="font-family: var(--font-mono)">Direct Link</label>
            <div class="flex items-center gap-2 rounded-lg bg-zinc-950/60 border border-zinc-800 p-1 pl-2.5">
              <input type="text" id="share-link-input" readonly class="bg-transparent text-xs text-zinc-300 w-full outline-none select-all" />
              <button id="copy-link-btn" class="cyber-btn flex items-center gap-1 px-3 py-1.5 rounded-md bg-zinc-900 border border-zinc-850 hover:border-highlight-500 hover:bg-highlight-950/20 hover:text-highlight-300 text-xs text-zinc-400 transition-colors" style="background-color: rgba(24, 24, 27, 0.9) !important; border: 1px solid rgba(63, 63, 70, 0.8) !important;">
                <span class="material-symbols-outlined text-xs">content_copy</span>
                <span id="copy-link-text">Copy</span>
              </button>
            </div>
          </div>

          <!-- Embed Code -->
          <div class="flex flex-col gap-1">
            <label class="text-[9px] uppercase tracking-wider text-zinc-500 font-bold" style="font-family: var(--font-mono)">Embed Player Frame</label>
            <div class="flex items-center gap-2 rounded-lg bg-zinc-950/60 border border-zinc-800 p-1 pl-2.5">
              <input type="text" id="share-embed-input" readonly class="bg-transparent text-xs text-zinc-300 w-full outline-none select-all" />
              <button id="copy-embed-btn" class="cyber-btn flex items-center gap-1 px-3 py-1.5 rounded-md bg-zinc-900 border border-zinc-850 hover:border-highlight-500 hover:bg-highlight-950/20 hover:text-highlight-300 text-xs text-zinc-400 transition-colors" style="background-color: rgba(24, 24, 27, 0.9) !important; border: 1px solid rgba(63, 63, 70, 0.8) !important;">
                <span class="material-symbols-outlined text-xs">code</span>
                <span id="copy-embed-text">Copy</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Collapsible Queue Panel overlay -->
    <div id="queue-panel" class="absolute bottom-[92px] left-4 right-4 z-50 rounded-2xl glass-panel shadow-2xl max-h-0 overflow-hidden transition-all duration-300 ease-in-out opacity-0">
      <div class="p-4">
        <div id="queue-links" class="flex flex-col gap-2 max-h-[160px] overflow-y-auto custom-scroll pr-1">
          <span class="text-sm text-zinc-500 uppercase italic">Loading schedule...</span>
        </div>
      </div>
    </div>

    <!-- Interactive Bottom Controls Bar -->
    <div class="cyber-footer glass-panel mt-2 flex flex-col flex-shrink-0 gap-2.5 rounded-lg p-2.5 shadow-md box-border">
      <!-- Row 2: Controls Group -->
      <div class="flex flex-row items-center justify-between w-full gap-3">
        <!-- Left Controls: Next, Related, Desync -->
        <div class="flex items-center gap-2">
          <button id="queue-trigger-btn" class="cyber-btn flex items-center gap-2.5 rounded-lg border border-zinc-800 bg-zinc-900/60 px-2.5 py-1 text-xs font-medium text-zinc-300 hover:border-highlight-500 hover:bg-highlight-950/20 hover:text-highlight-300" aria-label="Open broadcast queue schedule">
            <span class="material-symbols-outlined text-base">queue_music</span>
            <span>Next</span>
          </button>

          <button id="notes-trigger-btn" class="cyber-btn flex items-center gap-2.5 rounded-lg border border-zinc-800 bg-zinc-900/60 px-2.5 py-1 text-xs font-medium text-zinc-300 hover:border-highlight-500 hover:bg-highlight-950/20 hover:text-highlight-300" aria-label="Open related">
            <span class="material-symbols-outlined text-base">menu_book</span>
            <span>Related</span>
          </button>

          <button id="desync-btn" class="cyber-btn flex items-center gap-2.5 rounded-lg border border-zinc-800 bg-zinc-900/60 px-2.5 py-1 text-xs font-medium text-zinc-300 hover:border-red-500 hover:bg-red-950/20 hover:text-red-300" aria-label="Switch between broadcast and on-demand mode">
            <span class="material-symbols-outlined text-base">podcasts</span>
            <span id="desync-text">Desync</span>
          </button>
        </div>

        <!-- Right Controls: Mute, Volume, Share, PiP, Fullscreen -->
        <div class="flex items-center gap-2">
          <!-- Volume Group -->
          <div class="flex items-center gap-1">
            <button id="mute-toggle" class="flex items-center justify-center rounded-lg p-2 text-zinc-400 hover:bg-zinc-800 hover:text-highlight-400" aria-label="Toggle mute state" aria-checked="true">
              <span id="volume-icon-symbol" class="material-symbols-outlined text-lg">volume_off</span>
            </button>
            <input type="range" id="volume-control" class="h-1 w-16 cursor-pointer accent-highlight-500 bg-zinc-800 rounded-lg appearance-none" min="0" max="100" value="0" aria-label="Volume Slider" />
          </div>

          <!-- Utility Group (Share, PiP, Fullscreen) -->
          <div class="flex items-center gap-1">
            <button id="share-trigger-btn" class="flex items-center justify-center rounded-lg p-2 text-zinc-400 hover:bg-zinc-800 hover:text-highlight-400" title="Share Feed" aria-label="Share Cybernati Feed">
              <span class="material-symbols-outlined text-lg">share</span>
            </button>

            <button id="pip-btn" class="flex items-center justify-center rounded-lg p-2 text-zinc-400 hover:bg-zinc-800 hover:text-highlight-400" title="Picture in Picture" aria-label="Enable Picture-in-Picture">
              <span class="material-symbols-outlined text-lg">picture_in_picture_alt</span>
            </button>

            <button id="fullscreen-toggle" class="flex items-center justify-center rounded-lg p-2 text-zinc-400 hover:bg-zinc-800 hover:text-highlight-400" title="Fullscreen" aria-label="Toggle full screen">
              <span class="material-symbols-outlined text-lg">fullscreen</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Prevent flash of old player style on the live site before JS hijacks the iframe */
  iframe[src*="/player/"] {
    display: none !important;
  }

  /* Scoped CSS resets to isolate the player completely from parent theme styles */
  #global-cyber-player button {
    all: unset;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  /* Specific styling for standard buttons (Vault Notes, Desync) to override parent/prose themes */
  #global-cyber-player button.cyber-btn {
    background-color: rgba(24, 24, 27, 0.75) !important;
    border: 1px solid rgba(63, 63, 70, 0.6) !important;
    border-radius: 0.5rem !important;
    padding: 0.375rem 0.75rem !important;
    font-size: 0.75rem !important;
    font-weight: 500 !important;
    color: #e4e4e7 !important;
    /* WHY: Use the globally available --font-prose variable instead of the undefined --font-outfit variable to ensure buttons render in the correct premium font. */
    font-family: var(--font-prose), sans-serif !important;
    /* WHY: transition: all forces the browser to evaluate every property on every frame. Restricting it to target properties yields much smoother transitions. */
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease !important;
  }
  
  /* Isolated, tight overrides specifically for the footer control buttons (Next, Related, Desync) */
  #global-cyber-player .cyber-footer button.cyber-btn {
    padding: 0.05rem 0.375rem !important;
    border-radius: 0.25rem !important; /* Less round, sharp cyber corners */
    gap: 0.625rem !important;
    line-height: 1 !important;
  }
  #global-cyber-player .cyber-footer button.cyber-btn .material-symbols-outlined {
    font-size: 1.1rem !important;
    line-height: 1 !important;
  }
  
  /* Matches related notes overlay buttons to Next, Related, Desync tight aesthetics */
  #global-cyber-player .cyber-related-link,
  #global-cyber-player .cyber-pip-related-link {
    padding: 0.05rem 0.375rem !important;
    line-height: 1 !important;
    border-radius: 0.25rem !important;
    display: inline-flex !important;
    align-items: center !important;
  }
  #global-cyber-player button.cyber-btn:hover {
    background-color: rgb(var(--color-highlight-950, 88 28 135) / 0.25) !important;
    border-color: rgb(var(--color-highlight-500, 168 85 247)) !important;
