    border-radius: 8px;
    overflow: hidden;
    border: 2px solid rgb(var(--color-highlight-500, 168 85 247));
    cursor: move;
    /* WHY: Hint properties that will change during interactive dragging/resizing for hardware accelerated compositing layers. */
    will-change: bottom, right, width, height;
