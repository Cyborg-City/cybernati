      renderLinks: function(container, prog, isPip) {
        if (!container) return;
        const self = this;
        if (prog && prog.related && prog.related.length > 0) {
          container.innerHTML = generateRelatedLinksHTML(prog.related, base, isPip);

          container.querySelectorAll('a').forEach(linkEl => {
            linkEl.onclick = (e) => {
              e.preventDefault();
              
              /**
               * WHY: Clicking a related note in the player indicates active navigation to a new topic.
               * To prevent the strict opt-in filter from destroying the player during navigation,
               * we explicitly promote the player to Picture-in-Picture mode before starting the Swup transition.
               * By setting self.dontDockOnNextPage = true, we signal that the player must remain in floating
               * PiP mode on the new page, preventing it from auto-docking into the target page's video slot.
               * By setting self.isManuallyPip = true, self.isFloating = true, and calling self.checkSlotAndMount(),
               * we leverage the robust, battle-tested player state machine. It will automatically re-parent
               * the player to document.body, apply custom dimensions, and trigger recreating the YT player
               * cleanly, ensuring uninterrupted playback as the new page loads.
               */
              self.dontDockOnNextPage = true;
              if (!self.isFloating) {
                self.isManuallyPip = true;
                self.isFloating = true;
                self.checkSlotAndMount();
              }
              const href = linkEl.getAttribute('href');
              if (window.swup) window.swup.navigate(href);
              else window.location.href = href;
            };
          });
        } else {
          const sizeClass = isPip ? 'text-xs' : 'text-sm';
          container.innerHTML = `<span class="${sizeClass} text-zinc-500 uppercase italic">No related notes detected.</span>`;
        }
      },

      setupVolumeControls: function() {
        const self = this;
        let fadeFrameId = null;

        /**
         * WHY: Changes the player volume over a given duration to smooth out changes.
         * Uses requestAnimationFrame for display-synchronized, micro-smooth audio volume fading.
         */
        const fadeVolume = (targetVolume, duration = 300, onComplete) => {
          if (!self.player || !self.player.setVolume) {
            if (onComplete) onComplete();
            return;
          }
          if (fadeFrameId) cancelAnimationFrame(fadeFrameId);
          
          const startVolume = typeof self.currentFadeLinear === 'number' ? self.currentFadeLinear : (self.currentVolume || 0);
          const diff = targetVolume - startVolume;
          
          if (diff === 0) {
            if (self.player.setVolume) self.player.setVolume(toLogVolume(targetVolume));
            if (onComplete) onComplete();
            return;
          }
          
          const startTime = performance.now();
          
          const step = (now) => {
            const elapsed = now - startTime;
            const t = Math.min(1, elapsed / duration);
            
            const currentLinear = startVolume + diff * t;
            self.currentFadeLinear = currentLinear;
            
            if (self.player.setVolume) {
              self.player.setVolume(toLogVolume(currentLinear));
            }
            if (t < 1) {
              fadeFrameId = requestAnimationFrame(step);
            } else {
              fadeFrameId = null;
              self.currentFadeLinear = targetVolume;
              if (onComplete) onComplete();
            }
          };
          
          fadeFrameId = requestAnimationFrame(step);
        };

        /**
         * WHY: Syncs the mute buttons, volume sliders, and volume icons with the internal volume/mute state.
         */
        const syncVolumeDOM = () => {
          const vols = [
            { icon: document.getElementById('volume-icon-symbol'), control: document.getElementById('volume-control'), mute: document.getElementById('mute-toggle') },
            { icon: document.getElementById('pip-volume-icon-symbol'), control: document.getElementById('pip-volume-control'), mute: document.getElementById('pip-mute-toggle') }
          ];
          
          const symbol = (self.isMuted || self.currentVolume === 0) ? 'volume_off' : (self.currentVolume > 50 ? 'volume_up' : 'volume_down');
          const sliderVal = self.isMuted ? 0 : self.currentVolume;

          vols.forEach(v => {
            if (v.icon) v.icon.textContent = symbol;
            if (v.control) v.control.value = sliderVal;
            if (v.mute) {
              v.mute.setAttribute('aria-checked', self.isMuted ? 'true' : 'false');
              if (self.isMuted) v.mute.classList.remove('text-highlight-400');
              else v.mute.classList.add('text-highlight-400');
            }
          });
        };

        /**
         * WHY: Updates both mute and volume level state, writes to storage, and fades or sets YouTube player volume.
         */
        const updateVolumeState = (muted, volume, skipFade = false) => {
          self.isMuted = muted;
          if (volume !== undefined) self.currentVolume = volume;

          setPlayerStorage(PLAYER_STORAGE_KEYS.MUTED, self.isMuted ? 'true' : 'false');
          setPlayerStorage(PLAYER_STORAGE_KEYS.VOLUME, self.currentVolume.toString());

          if (self.player) {
            if (self.isMuted) {
              if (skipFade) {
                if (self.player.setVolume) self.player.setVolume(0);
                if (self.player.mute) self.player.mute();
              } else {
                fadeVolume(0, 300, () => { if (self.player.mute) self.player.mute(); });
              }
            } else {
              if (!skipFade) {
                if (self.player.setVolume) self.player.setVolume(0);
                if (self.player.unMute) self.player.unMute();
                self.currentFadeLinear = 0; 
                fadeVolume(self.currentVolume, 300);
              } else {
                if (self.player.setVolume) self.player.setVolume(toLogVolume(self.currentVolume));
                if (self.player.unMute) self.player.unMute();
                self.currentFadeLinear = self.currentVolume;
              }
            }
          }
          syncVolumeDOM();
        };

        const setupMute = (id) => {
          const btn = document.getElementById(id);
          if (btn) {
            btn.onclick = () => {
              const nextMuted = !self.isMuted;
              let nextVol = self.currentVolume;
              if (!nextMuted && self.currentVolume === 0) nextVol = 25;
              updateVolumeState(nextMuted, nextVol, false);
            };
          }
        };
        setupMute('mute-toggle');
        setupMute('pip-mute-toggle');

        const setupVol = (id) => {
          const slider = document.getElementById(id);
          if (slider) {
            slider.oninput = (e) => {
              const val = parseInt(e.target.value, 10);
              updateVolumeState(val === 0, val, true);
            };
          }
        };
        setupVol('volume-control');
        setupVol('pip-volume-control');

        const handleInteraction = (e) => {
          if (self.handshakeEstablished) return;
          self.handshakeEstablished = true;
          setPlayerStorage(PLAYER_STORAGE_KEYS.HANDSHAKE, 'true');
          
          if (e && e.target && e.target.closest('button, input')) return;

          // Always start muted on reload/refresh interaction
          updateVolumeState(true, self.currentVolume || 25, true);
        };
        window.addEventListener('click', handleInteraction, { once: true });

        return {
          updateVolumeState,
          syncVolumeDOM,
          fadeVolume
        };
      },

      setupPipControls: function() {
        const self = this;
        const globalPlayer = document.getElementById('global-cyber-player') || self.el;

        // PiP Close Button
        const pipClose = document.getElementById('pip-exit-btn');
        if (pipClose) {
          pipClose.onclick = () => {
            self.destroy();
          };
        }

        // PiP Return Button
        const pipReturn = document.getElementById('pip-return-btn');
        if (pipReturn) {
          pipReturn.onclick = (e) => {
            e.stopPropagation();
            self.isManuallyPip = false;
            self.isFloating = false;
            if (self.dockedUrl) {
              if (window.swup) window.swup.navigate(self.dockedUrl);
              else window.location.href = self.dockedUrl;
            }
          };
        }

        // PiP Fullscreen Button
        const pipFullscreen = document.getElementById('pip-fullscreen-btn');
        if (pipFullscreen) {
          pipFullscreen.onclick = (e) => {
            e.stopPropagation();
            const root = document.getElementById('player-root');
            if (root) {
              if (!document.fullscreenElement) root.requestFullscreen();
              else document.exitFullscreen();
            }
          };
        }

        // PiP Vault Notes Button
        const pipNotesBtn = document.getElementById('pip-notes-btn');
        const pipNotesPanel = document.getElementById('pip-notes-panel');
        if (pipNotesBtn && pipNotesPanel) {
          pipNotesBtn.onclick = (e) => {
            e.stopPropagation();
            const isOpen = pipNotesPanel.classList.contains('is-visible');
            if (isOpen) {
              pipNotesPanel.classList.remove('is-visible');
              pipNotesPanel.classList.add('max-h-0');
              pipNotesPanel.classList.remove('max-h-[140px]');
              pipNotesBtn.classList.remove('text-highlight-400');
            } else {
              pipNotesPanel.classList.add('is-visible');
              pipNotesPanel.classList.remove('max-h-0');
              pipNotesPanel.classList.add('max-h-[140px]');
              pipNotesBtn.classList.add('text-highlight-400');
              self.renderLinks(document.getElementById('pip-related-links'), self._activeProgram, true);
            }
          };
        }

        const pipOverlay = document.getElementById('pip-controls-overlay');
        const pipHeaderOverlay = document.getElementById('pip-header-overlay');
        let overlayHideTimer = null;
        self.showOverlay = () => {
          if (!self.isFloating) return;
          if (pipOverlay) pipOverlay.classList.add('is-visible');
          if (pipHeaderOverlay) pipHeaderOverlay.classList.add('is-visible');
          clearTimeout(overlayHideTimer);
        };
        self.scheduleHideOverlay = () => {
          clearTimeout(overlayHideTimer);
          overlayHideTimer = setTimeout(() => {
            if (pipOverlay) pipOverlay.classList.remove('is-visible');
            if (pipHeaderOverlay) pipHeaderOverlay.classList.remove('is-visible');
            
            // Auto-collapse notes panel when controls overlay fades out
            if (pipNotesPanel) {
              pipNotesPanel.classList.remove('is-visible');
              pipNotesPanel.classList.add('max-h-0');
              pipNotesPanel.classList.remove('max-h-[140px]');
            }
            if (pipNotesBtn) {
              pipNotesBtn.classList.remove('text-highlight-400');
            }
          }, 3000);
        };

        if (globalPlayer) {
          globalPlayer.addEventListener('mousemove', () => { self.showOverlay(); self.scheduleHideOverlay(); }, { passive: true });
          globalPlayer.addEventListener('mouseenter', () => { self.showOverlay(); }, { passive: true });
          globalPlayer.addEventListener('mouseleave', () => { self.scheduleHideOverlay(); }, { passive: true });
        }
      },

      setupPanelControls: function() {
        const self = this;
        
        const notesTrigger = document.getElementById('notes-trigger-btn');
        const closeNotes = document.getElementById('close-notes-btn');
        const notesPanel = document.getElementById('related-notes-panel');
        const shareTrigger = document.getElementById('share-trigger-btn');
        const closeShare = document.getElementById('close-share-btn');
        const sharePanel = document.getElementById('share-panel');
        const shareLinkInput = document.getElementById('share-link-input');
        const shareEmbedInput = document.getElementById('share-embed-input');
        const queueTrigger = document.getElementById('queue-trigger-btn');
        const closeQueue = document.getElementById('close-queue-btn');
        const queuePanel = document.getElementById('queue-panel');

        const closeAllPanels = () => {
          closePanel(notesPanel);
          closePanel(sharePanel);
          closePanel(queuePanel);
        };

        if (notesTrigger && notesPanel) {
          notesTrigger.onclick = () => {
            const isOpen = notesPanel.classList.contains('opacity-100');
            closeAllPanels();
            if (!isOpen) {
              openPanel(notesPanel);
            }
          };
        }
        if (closeNotes && notesPanel) {
          closeNotes.onclick = () => {
            closePanel(notesPanel);
          };
        }

        if (shareTrigger && sharePanel) {
          shareTrigger.onclick = () => {
            const isOpen = sharePanel.classList.contains('opacity-100');
            closeAllPanels();
            if (!isOpen) {
              openPanel(sharePanel);

              // Dynamically generate share link and embed code
              const cleanBase = base.endsWith('/') ? base : base + '/';
              const embedUrl = `${window.location.origin}${cleanBase}player/${self.currentType || 'video'}/${self.currentPlaylist || 'channel-000'}`;
              
              if (shareLinkInput) {
                shareLinkInput.value = window.location.href;
                shareLinkInput.select();
              }
              if (shareEmbedInput) {
                shareEmbedInput.value = `<iframe src="${embedUrl}" width="100%" height="550" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" style="border-radius: 16px; background: #000; box-shadow: 0 10px 30px rgba(0,0,0,0.5);"></iframe>`;
              }
            }
          };
        }

        if (closeShare && sharePanel) {
          closeShare.onclick = () => {
            closePanel(sharePanel);
          };
        }

        if (queueTrigger && queuePanel) {
          queueTrigger.onclick = () => {
            const isOpen = queuePanel.classList.contains('opacity-100');
            closeAllPanels();
            if (!isOpen) {
              openPanel(queuePanel);
              self.renderQueue();
            }
          };
        }

        if (closeQueue && queuePanel) {
          closeQueue.onclick = () => {
            closePanel(queuePanel);
          };
        }

        // Link copy logic
        const copyLinkBtn = document.getElementById('copy-link-btn');
        const copyLinkText = document.getElementById('copy-link-text');
        if (copyLinkBtn && shareLinkInput) {
          copyLinkBtn.onclick = () => {
            navigator.clipboard.writeText(shareLinkInput.value).then(() => {
              if (copyLinkText) {
                copyLinkText.textContent = 'Copied!';
                setTimeout(() => {
                  copyLinkText.textContent = 'Copy';
                }, 2000);
              }
            });
          };
        }

        // Embed copy logic
        const copyEmbedBtn = document.getElementById('copy-embed-btn');
        const copyEmbedText = document.getElementById('copy-embed-text');
        if (copyEmbedBtn && shareEmbedInput) {
          copyEmbedBtn.onclick = () => {
            navigator.clipboard.writeText(shareEmbedInput.value).then(() => {
              if (copyEmbedText) {
                copyEmbedText.textContent = 'Copied!';
                setTimeout(() => {
                  copyEmbedText.textContent = 'Copy';
                }, 2000);
              }
            });
          };
        }

        // Close overlays on clicking outside
        window.addEventListener('click', (e) => {
          const target = e.target;
          
          // Intercept related note links and start/preserve PiP mode
          const link = target ? target.closest('a') : null;
          if (link) {
            const isPlayerRelated = link.classList.contains('cyber-related-link') || link.classList.contains('cyber-pip-related-link');
            const isPageRelated = link.closest('#linked-mentions-content');
            if (isPlayerRelated || isPageRelated) {
              if (self.currentPlaylist) {
                // WHY: Prevent default navigation immediately. This stops Swup or the browser from starting
                // the page transition before we have finished physically re-parenting the global player container
                // to document.body and setting its PiP state!
                e.preventDefault();
                
                self.dontDockOnNextPage = true;
                if (!self.isFloating) {
                  self.isManuallyPip = true;
                  self.isFloating = true;
                  self.checkSlotAndMount();
                }
                
                // Now that the player is safely floated, trigger the navigation manually!
                const href = link.getAttribute('href');
                if (href) {
                  if (window.swup) {
                    window.swup.navigate(href);
                  } else {
                    window.location.href = href;
                  }
                }
              }
            }
          }
          
          const isOutside = (targetId, triggerId) => {
            const panel = document.getElementById(targetId);
            const trigger = document.getElementById(triggerId);
            if (!panel || panel.classList.contains('opacity-0')) return false;
            
            if (trigger && (trigger === target || trigger.contains(target))) return false;
            if (panel && (panel === target || panel.contains(target))) return false;
            
            return true;
          };

          if (isOutside('related-notes-panel', 'notes-trigger-btn')) {
            closePanel(document.getElementById('related-notes-panel'));
          }
          
          if (isOutside('queue-panel', 'queue-trigger-btn')) {
            closePanel(document.getElementById('queue-panel'));
          }
          
          if (isOutside('share-panel', 'share-trigger-btn')) {
            closePanel(document.getElementById('share-panel'));
          }
        });

        return {
          closeAllPanels
        };
      },

      /**
       * WHY: Decouples drag and custom resize logic for the Picture-in-Picture window.
       * Keeps aspect ratio locked to 16:9 while resizing and saves dimensions to localStorage
       * once sizing is finished to persist the player size across page navigations.
       */
      setupDragAndResize: function() {
        const self = this;
        const globalPlayer = document.getElementById('global-cyber-player') || self.el;
        if (!globalPlayer) return;

        // Draggable logic for PiP
        // WHY: We track isDragging and check if the mouse has moved more than 5px to mark it as a "drag" rather than a "click", preventing accidental video toggling when repositioning the PiP window.
        let isDragging = false, startX, startY, initialRight, initialBottom, currentDragWidth, currentDragHeight;
        self.wasDragged = false;

        const onMouseMove = (e) => {
          if (!isDragging) return;
          e.preventDefault();
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          
          // If the mouse has moved more than 5px in any direction, it's a drag
          if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
            self.wasDragged = true;
          }
          
          // Constrain to viewport using dynamic width/height
          let newRight = Math.max(0, Math.min(window.innerWidth - currentDragWidth, initialRight - dx));
          let newBottom = Math.max(0, Math.min(window.innerHeight - currentDragHeight, initialBottom - dy));
          
          globalPlayer.style.right = newRight + 'px';
          globalPlayer.style.bottom = newBottom + 'px';
        };

        const onMouseUp = () => {
          if (isDragging) {
            isDragging = false;
            document.removeEventListener('mousemove', onMouseMove);
            document.removeEventListener('mouseup', onMouseUp);
            globalPlayer.style.transition = '';
            
            // Clear wasDragged slightly delayed so click handler has time to intercept
            setTimeout(() => {
              self.wasDragged = false;
            }, 80);
          }
        };
        
        const dragHandle = document.getElementById('player-click-overlay');
        if (dragHandle) {
          dragHandle.addEventListener('mousedown', (e) => {
            if (!self.isFloating) return;
            // Ignore clicks near bottom controls
            if (e.offsetY > dragHandle.offsetHeight - 40) return;
            
            isDragging = true;
            startX = e.clientX;
            startY = e.clientY;
            const rect = globalPlayer.getBoundingClientRect();
            currentDragWidth = rect.width;
            currentDragHeight = rect.height;
            initialRight = window.innerWidth - rect.right;
            initialBottom = window.innerHeight - rect.bottom;
            
            globalPlayer.style.transition = 'none';
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
          });
        }

        // Invisible Edge/Corner Resizing Logic for PiP (Locked 16:9 Aspect Ratio)
        let isResizing = false;
        let resizeDir = '';
        let startResizeX, startResizeY;
        let initialRect, initialWidth, initialHeight;
        
        const onResizeMouseMove = (e) => {
          if (!isResizing) return;
          e.preventDefault();
          
          const dx = e.clientX - startResizeX;
          const dy = e.clientY - startResizeY;
          
          let newWidth = initialWidth;
          let newHeight = initialHeight;
          
          // Determine primary sizing based on drag direction
          if (['l', 'r', 'tl', 'tr', 'bl', 'br'].includes(resizeDir)) {
            // Width-driven sizing
            if (['l', 'tl', 'bl'].includes(resizeDir)) {
              newWidth = initialWidth - dx;
            } else {
              newWidth = initialWidth + dx;
            }
            // Constrain width
            newWidth = Math.max(240, Math.min(800, newWidth));
            newHeight = Math.round(newWidth / (16 / 9));
          } else if (['t', 'b'].includes(resizeDir)) {
            // Height-driven sizing
            if (resizeDir === 't') {
              newHeight = initialHeight - dy;
            } else {
              newHeight = initialHeight + dy;
            }
            // Constrain height
            newHeight = Math.max(135, Math.min(450, newHeight));
            newWidth = Math.round(newHeight * (16 / 9));
          }
          
          // Apply dimensions
          globalPlayer.style.width = newWidth + 'px';
          globalPlayer.style.height = newHeight + 'px';
          
          // Adjust position offsets depending on anchor point
          // Anchor Bottom-Right (fixed bottom/right offsets) for tl, t, l resizing
          if (['tl', 't', 'l'].includes(resizeDir)) {
            const newRight = window.innerWidth - initialRect.right;
            const newBottom = window.innerHeight - initialRect.bottom;
            globalPlayer.style.right = newRight + 'px';
            globalPlayer.style.bottom = newBottom + 'px';
          }
          // Anchor Top-Left (fixed top/left coordinates) for br, b, r resizing
          else if (['br', 'b', 'r'].includes(resizeDir)) {
            const newRight = window.innerWidth - initialRect.left - newWidth;
            const newBottom = window.innerHeight - initialRect.top - newHeight;
            globalPlayer.style.right = newRight + 'px';
            globalPlayer.style.bottom = newBottom + 'px';
          }
          // Anchor Bottom-Left (fixed bottom/left) for tr resizing
          else if (resizeDir === 'tr') {
            const newRight = window.innerWidth - initialRect.left - newWidth;
            const newBottom = window.innerHeight - initialRect.bottom;
            globalPlayer.style.right = newRight + 'px';
            globalPlayer.style.bottom = newBottom + 'px';
          }
          // Anchor Top-Right (fixed top/right) for bl resizing
          else if (resizeDir === 'bl') {
            const newRight = window.innerWidth - initialRect.right;
            const newBottom = window.innerHeight - initialRect.top - newHeight;
            globalPlayer.style.right = newRight + 'px';
            globalPlayer.style.bottom = newBottom + 'px';
          }
        };
        
        const onResizeMouseUp = () => {
          if (isResizing) {
            isResizing = false;
            document.removeEventListener('mousemove', onResizeMouseMove);
            document.removeEventListener('mouseup', onResizeMouseUp);
            
            // Save resized state in localStorage
            const rect = globalPlayer.getBoundingClientRect();
            setPlayerStorage(PLAYER_STORAGE_KEYS.PIP_WIDTH, Math.round(rect.width).toString());
            setPlayerStorage(PLAYER_STORAGE_KEYS.PIP_HEIGHT, Math.round(rect.height).toString());
            
            globalPlayer.style.transition = '';
          }
        };
        
        globalPlayer.querySelectorAll('.pip-resizer').forEach(resizer => {
          resizer.addEventListener('mousedown', (e) => {
            if (!self.isFloating) return;
            e.stopPropagation();
            e.preventDefault();
            
            isResizing = true;
            resizeDir = resizer.getAttribute('data-direction');
            startResizeX = e.clientX;
            startResizeY = e.clientY;
            initialRect = globalPlayer.getBoundingClientRect();
            initialWidth = initialRect.width;
            initialHeight = initialRect.height;
            
            globalPlayer.style.transition = 'none';
            document.addEventListener('mousemove', onResizeMouseMove);
            document.addEventListener('mouseup', onResizeMouseUp);
          });
        });
      },

      /**
       * WHY: Binds global keyboard shortcuts for the CyberPlayer.
       * Guards aggressively against typing in form controls or Giscus comment frames
       * to keep the default browser inputs functional.
       */
      setupHotkeys: function(updateVolumeState, closeAllPanels) {
        const self = this;
        window.addEventListener('keydown', (e) => {
          const active = document.activeElement;
          if (active && (
            active.tagName === 'INPUT' || 
            active.tagName === 'TEXTAREA' || 
            active.isContentEditable
          )) {
            return; // Exit: User is typing!
          }

          // Only process keyboard controls when the player is actively initialized/playing
          const isPlaying = getPlayerStorage(PLAYER_STORAGE_KEYS.PLAYING) === 'true';
          if (!isPlaying || !self.currentPlaylist) return;

          switch (e.key.toLowerCase()) {
            case 'm':
              e.preventDefault();
              const nextMuted = !self.isMuted;
              let nextVol = self.currentVolume;
              if (!nextMuted && self.currentVolume === 0) nextVol = 25;
              updateVolumeState(nextMuted, nextVol, false);
              break;
            case 'f':
              e.preventDefault();
              const root = document.getElementById('player-root');
              if (root) {
                if (!document.fullscreenElement) root.requestFullscreen();
                else document.exitFullscreen();
              }
              break;
            case 'p':
              e.preventDefault();
              if (self.isFloating) {
                // If in PiP, toggle back to the source page if recorded, otherwise dock on current page
                if (self.dockedUrl && window.location.pathname !== self.dockedUrl) {
                  self.isManuallyPip = false;
                  self.isFloating = false;
                  if (window.swup) window.swup.navigate(self.dockedUrl);
                  else window.location.href = self.dockedUrl;
                } else {
                  self.isManuallyPip = false;
                  self.isFloating = false;
                  self.checkSlotAndMount();
                }
              } else {
                // Toggle from slotted to floating PiP mode
                self.isManuallyPip = true;
                self.isFloating = true;
                self.checkSlotAndMount();
              }
              break;
            case 'r':
              e.preventDefault();
              if (self.isFloating) {
                // Toggle the PiP compact Related Notes panel
                const pipNotesBtn = document.getElementById('pip-notes-btn');
                const pipNotesPanel = document.getElementById('pip-notes-panel');
                if (pipNotesBtn && pipNotesPanel) {
                  const isOpen = pipNotesPanel.classList.contains('is-visible');
                  if (isOpen) {
                    pipNotesPanel.classList.remove('is-visible');
                    pipNotesPanel.classList.add('max-h-0');
                    pipNotesPanel.classList.remove('max-h-[140px]');
                    pipNotesBtn.classList.remove('text-highlight-400');
                  } else {
                    pipNotesPanel.classList.add('is-visible');
                    pipNotesPanel.classList.remove('max-h-0');
                    pipNotesPanel.classList.add('max-h-[140px]');
                    pipNotesBtn.classList.add('text-highlight-400');
                    self.renderLinks(document.getElementById('pip-related-links'), self._activeProgram, true);
                  }
                }
              } else {
                // Toggle the standard slotted/fullscreen Related Notes panel
                const notesPanel = document.getElementById('related-notes-panel');
                if (notesPanel) {
                  const isOpen = notesPanel.classList.contains('opacity-100');
                  closeAllPanels();
                  if (!isOpen) {
                    openPanel(notesPanel);
                  }
                }
              }
              break;
            case 'arrowup':
              e.preventDefault();
              let upVol = Math.min((self.currentVolume || 0) + 5, 100);
              updateVolumeState(upVol === 0, upVol, true);
              break;
            case 'arrowdown':
              e.preventDefault();
              let downVol = Math.max((self.currentVolume || 0) - 5, 0);
              updateVolumeState(downVol === 0, downVol, true);
              break;
          }
        });
      },

      ensureYoutubeAPI: function(callback) {
        // WHY: Dynamically load the YouTube Iframe Player API on-demand. Using the YoutubeApiLoader
        // class ensures we coordinate simultaneous loading attempts cleanly and execute callbacks
        // instantly when YouTube calls onYouTubeIframeAPIReady, avoiding expensive polling intervals.
        ytLoader.ensureLoaded(
          callback,
          () => !!(window.YT && window.YT.Player),
          (onReady) => {
            const prev = window.onYouTubeIframeAPIReady;
            window.onYouTubeIframeAPIReady = () => {
              if (prev) prev();
              onReady();
            };

            if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
              const tag = document.createElement('script');
              tag.src = "https://www.youtube.com/iframe_api";
              document.head.appendChild(tag);
            }
          }
        );
      },

      // State handling
      // WHY: Initializes the global player once per session. Sets up Swup listeners and a MutationObserver to automatically move the player in and out of the DOM slot during page transitions without destroying the player instance.
      initGlobal: function() {
        this.el = document.getElementById('global-cyber-player');
        this.setupUI();
        this.checkSlotAndMount();

        // WHY: Set up a MutationObserver to watch the DOM for the dynamic appearance of '#cyber-player-slot' or iframe embeds.
        // A 50ms debounce collapses rapid DOM bursts (Swup transition, HMR, player's own innerHTML writes) into a single checkSlotAndMount call,
        // eliminating redundant querySelectorAll('iframe') scans on every micro-mutation.
        let mutationDebounceTimer = null;
        const observer = new MutationObserver(() => {
          clearTimeout(mutationDebounceTimer);
          mutationDebounceTimer = setTimeout(() => {
            this.checkSlotAndMount(this.isSwupTransitioning);
          }, 50);
        });
        observer.observe(document.body, { childList: true, subtree: true });

        const setupSwupHooks = () => {
          if (!window.swup) return;
          
          // WHY: As soon as a user clicks a link and Swup starts the transition, we must immediately rescue the global player DOM from the container about to be replaced. We move it back to document.body and temporarily transition it to PiP mode if explicitly requested by the user!
          window.swup.hooks.on('visit:start', () => {
            this.isSwupTransitioning = true; // Mark transition as active
            const globalPlayer = document.getElementById('global-cyber-player') || this.el;
            if (globalPlayer && globalPlayer.classList.contains('is-slotted')) {
              const shouldFloat = shouldFloatToPip({
                currentPlaylist: this.currentPlaylist,
                isFloating: this.isFloating,
                isManuallyPip: this.isManuallyPip,
                isMuted: this.isMuted
              });

              if (shouldFloat) {
                withNoTransition(globalPlayer, () => {
                  globalPlayer.remove(); // Remove from slotted parent immediately
                  globalPlayer.classList.remove('is-slotted');
                  globalPlayer.classList.add('is-pip');
                  globalPlayer.classList.remove('is-hidden'); // Visual Override: Ensure always visible!
                  this.isFloating = true;
                  document.body.appendChild(globalPlayer);
                });
              } else {
                globalPlayer.remove();
                this.destroy(); // Halts and destroys the YouTube player cleanly!
              }
            }
          });

          // WHY: As soon as Swup replaces the DOM contents (before transition animations complete), we immediately run checkSlotAndMount to dismantle and replace the fallback iframe. This completely prevents duplicate background audio from starting!
          window.swup.hooks.on('content:replace', () => {
            this.checkSlotAndMount(true); // Dismantle fallback iframes immediately to stop audio, but don't dock yet
          });

          // WHY: After Swup has completed rendering the new page and replacing the container DOM, we check if the new page contains a designated video player slot (or an iframe to hijack). If it does, we dock the player into the new slot.
          window.swup.hooks.on('page:view', () => {
            this.isSwupTransitioning = false; // Transition complete
            if (this.dontDockOnNextPage) {
              this.dontDockOnNextPage = false;
              this.isManuallyPip = true; // Retain PiP floating state
            }
            this.checkSlotAndMount(false); // Dock and recreate YT player cleanly once DOM is fully settled
          });
        };

        // Hook into Swup
        if (window.swup) {
          setupSwupHooks();
        } else {
          // If swup isn't ready yet, wait for it via DOM event
          document.addEventListener('swup:enable', setupSwupHooks);
        }

        // F5 Restore fallback
        // WHY: If the user manually refreshes the page (F5) while in PiP mode, the DOM is rebuilt. We read localStorage to instantly restore the floating player without requiring them to visit a video page first.
        const wasPlaying = getPlayerStorage(PLAYER_STORAGE_KEYS.PLAYING) === 'true';
        const lastPlaylist = getPlayerStorage(PLAYER_STORAGE_KEYS.PLAYLIST);
        
        if (wasPlaying && lastPlaylist && !document.getElementById('cyber-player-slot')) {
          const parts = lastPlaylist.split('/');
          if (parts.length >= 2) {
            this.activate(parts[0], parts[1], true);
          }
        }
      },

      // WHY: Detects if the current page has a designated slot for the player.
      // It also handles "iframe hijacking" for Obsidian fallbacks. If an author uses a standard markdown iframe to embed the player (which works perfectly in Obsidian), the live site will intercept that iframe, hide it, and snap the Global Player into its place to maintain persistent audio!
      checkSlotAndMount: function(dismantleOnly) {
        let slot = document.getElementById('cyber-player-slot');
        const globalPlayer = document.getElementById('global-cyber-player') || this.el;
        if (!globalPlayer) return;

        // Iframe Hijacking for Obsidian compatibility
        if (!slot) {
          const iframes = document.querySelectorAll('iframe');
          const iframeMatch = Array.from(iframes).find(iframe => {
            const src = iframe.getAttribute('src') || '';
            return src.includes('/player/');
          });
          
          if (iframeMatch) {
            // Create a slot right before the iframe and hide the iframe
            slot = document.createElement('div');
            slot.id = 'cyber-player-slot';
            slot.className = 'w-full my-6 relative bg-zinc-950 rounded-2xl overflow-hidden not-prose';
            
            // WHY: For the hijacked slot on the live site, we ALWAYS enforce a perfect 16:9 aspect ratio
            // using Tailwind's 'aspect-video' utility. Enforcing this makes the slot fully responsive,
            // scaling the height proportionally as the page width changes. This completely eliminates
            // vertical and horizontal black bars, ensuring the premium overlays align perfectly with the video boundaries!
            slot.classList.add('aspect-video');
            
            // Extract type and playlist from iframe src (e.g. /cybernati/player/video/channel-000)
            const srcParts = iframeMatch.getAttribute('src').split('/player/');
            if (srcParts.length > 1) {
              const metaParts = srcParts[1].replace(/\/$/, '').split('/');
              if (metaParts.length >= 2) {
                slot.setAttribute('data-type', metaParts[0]);
                slot.setAttribute('data-playlist', metaParts[1]);
              }
            }
            
            iframeMatch.parentNode.insertBefore(slot, iframeMatch);
            iframeMatch.remove(); // Remove the iframe completely so it does not load or double-play in the background!
          }
        }

        // If we only wanted to dismantle the fallback iframe to prevent duplicate audio, we stop here!
        if (dismantleOnly) {
          return;
        }

        const type = slot ? slot.getAttribute('data-type') || 'video' : null;
        const playlist = slot ? slot.getAttribute('data-playlist') || 'channel-000' : null;

        // WHY: We delegate the docking state machine decision to the pure, unit-tested 'shouldDockToSlot' helper.
        // This ensures the player docks only when appropriate, preventing double-audio or reload interruptions.
        const shouldDock = shouldDockToSlot({
          hasSlot: !!slot,
          isManuallyPip: this.isManuallyPip,
          currentPlaylist: this.currentPlaylist,
          currentType: this.currentType,
          slotPlaylist: playlist,
          slotType: type
        });

        if (shouldDock) {
          // Save the current location as the docked page URL so we can return to it from PiP
          this.dockedUrl = window.location.pathname;

          // If already docked and playlist/type hasn't changed, do nothing!
          if (globalPlayer.parentNode === slot && this.currentPlaylist === playlist && this.currentType === type) {
            return;
          }

          // Reset manual override and floating state since we are docking into the slot
          this.isManuallyPip = false;
          this.isFloating = false;

          // WHY: Disable transitions during docking re-parenting to prevent visual stretching
          // or flashing across the page.
          let parentChanged = false;
          withNoTransition(globalPlayer, () => {
            globalPlayer.classList.remove('is-hidden', 'is-pip');
            globalPlayer.classList.add('is-slotted');
            
            // Physically move the player DOM into the slot
            parentChanged = globalPlayer.parentNode !== slot;
            if (parentChanged) {
              slot.appendChild(globalPlayer);
            }
            
            // Ensure it's positioned correctly
            globalPlayer.style.bottom = 'auto';
            globalPlayer.style.right = 'auto';
            globalPlayer.style.width = '';
            globalPlayer.style.height = '';
          });

          // If playlist changed, load new data
          if (this.currentPlaylist !== playlist || this.currentType !== type) {
            this.activate(type, playlist, false);
          } else if (parentChanged) {
            // Force re-create YouTube player since iframe was re-parented
            this.recreateYTPlayer();
          }
        } else {
          // No slot found or manually forced to PiP. If playing, float it if explicitly requested by the user.
          // WHY: PiP mode is strictly opt-in. We only transition to floating/PiP if the user has explicitly requested/activated PiP (either isFloating or isManuallyPip is true).
          // Otherwise, we destroy it immediately to stop all audio and network loading.
          const shouldFloat = shouldFloatToPip({
            currentPlaylist: this.currentPlaylist,
            isFloating: this.isFloating,
            isManuallyPip: this.isManuallyPip,
            isMuted: this.isMuted
          });

          if (shouldFloat) {
            if (globalPlayer.classList.contains('is-pip') && globalPlayer.parentNode === document.body) {
              globalPlayer.classList.remove('is-hidden'); // Visual Override: Ensure always visible!
              return; // Already floating, do nothing!
            }
            let parentChanged = false;
            withNoTransition(globalPlayer, () => {
              globalPlayer.classList.remove('is-slotted');
              globalPlayer.classList.add('is-pip');
              globalPlayer.classList.remove('is-hidden'); // Visual Override: Ensure always visible!
              
              // Clear any inline positioning styles set during slotting or dragging
              globalPlayer.style.bottom = '';
              globalPlayer.style.right = '';
              
              // Restore custom resized size if saved in localStorage
              globalPlayer.style.width = '';
              globalPlayer.style.height = '';
              restorePipSize(globalPlayer);
              
              // Move back to body to ensure it isn't destroyed by Swup
              parentChanged = globalPlayer.parentNode !== document.body;
              document.body.appendChild(globalPlayer);
              this.isFloating = true;
            });

            if (parentChanged) {
              // Force re-create YouTube player since iframe was re-parented
              this.recreateYTPlayer();
            }
          } else {
            // Not playing or not explicitly PiP, destroy it completely if not already hidden and in body.
            // WHY: This early return is critical! Since destroy() appends the player back to document.body,
            // it triggers the MutationObserver. If we did not return early, this would create an infinite recursive
            // loop that completely freezes the browser main thread (unresponsive page)!
            if (globalPlayer.classList.contains('is-hidden') && globalPlayer.parentNode === document.body) {
              return;
            }
            this.destroy();
          }
        }

        // Update the PiP Return button visibility based on whether we are floating and have a target URL
        const returnBtn = document.getElementById('pip-return-btn');
        if (returnBtn) {
          if (this.isFloating && this.dockedUrl) {
            returnBtn.classList.remove('hidden');
          } else {
            returnBtn.classList.add('hidden');
          }
        }
      },

      // WHY: Fetches the playlist JSON for the requested channel, and boots up the synchronization loop. 
      // It also ensures the browser state is saved to localStorage so F5 reloads can restore correctly.
      activate: async function(type, playlist, forcePip) {
        this.currentType = type;
        this.currentPlaylist = playlist;
        
        setPlayerStorage(PLAYER_STORAGE_KEYS.PLAYLIST, `${type}/${playlist}`);

        const globalPlayer = document.getElementById('global-cyber-player') || this.el;
        if (forcePip) {
          globalPlayer.classList.remove('is-hidden', 'is-slotted');
          globalPlayer.classList.add('is-pip');
          
          // Clear styles and restore custom resized size
          globalPlayer.style.bottom = '';
          globalPlayer.style.right = '';
          globalPlayer.style.width = '';
          globalPlayer.style.height = '';
          restorePipSize(globalPlayer);
          
          document.body.appendChild(globalPlayer);
          this.isFloating = true;
        } else {
          // Ensure playing state is stored so F5 can restore it
          setPlayerStorage(PLAYER_STORAGE_KEYS.PLAYING, 'true');
        }

        try {
          const hostPath = window.location.origin;
          const cleanBase = base.endsWith('/') ? base : base + '/';
          const playlistUrl = `${hostPath}${cleanBase}api/playlists/${type}/${playlist}.json?v=${Date.now()}`;
          
          const response = await fetch(playlistUrl);
          if (!response.ok) throw new Error("Playlist file missing.");
          this.playlistData = await response.json();
          
          this.startLoop();
          this.renderQueue();
        } catch (e) {
          console.error("Player initialization failure:", e);
        }
      },

      // WHY: Dynamically renders the single upcoming track in the current schedule/playlist.
      // It shows only the title of the next video that will be played.
      renderQueue: function() {
        const queueEl = document.getElementById('queue-links');
        if (!queueEl || !this.playlistData || !this.playlistData.schedule) return;
        
        const schedule = this.playlistData.schedule;
        if (schedule.length === 0) return;

        const now = Math.floor(Date.now() / 1000);
        const pos = now % this.playlistData.totalLoopDuration;
        
        let nextIndex = 0;
        for (let i = 0; i < schedule.length; i++) {
          const p = schedule[i];
          if (pos >= p.start && pos < p.end) {
            nextIndex = (i + 1) % schedule.length;
            break;
          }
        }
        
        const nextVideo = schedule[nextIndex];
        if (!nextVideo) {
          queueEl.innerHTML = '<span class="text-sm text-zinc-500 uppercase italic">No upcoming feeds.</span>';
          return;
        }
        
        queueEl.innerHTML = `
          <div class="py-1 text-sm text-highlight-400 font-bold transition-all uppercase truncate" style="box-sizing: border-box !important;">
            ${nextVideo.title.toUpperCase()}
          </div>
        `;
      },

      destroy: function() {
        if (this.updateTimer) clearInterval(this.updateTimer);
        if (this.desyncTimer) clearInterval(this.desyncTimer);
        if (this.player && this.player.destroy) {
          try { this.player.destroy(); } catch (e) {}
        }
        this.player = null;
        this.currentVideoId = null;
        this.currentPlaylist = null;
        this.currentType = null;
        this.isFloating = false;
        this.isManuallyPip = false; // Reset PiP manual override to ensure clean state on next visit.
        
        // WHY: Clean up the player mount to halt any running HTML5 video elements (like loop interstitials) immediately, reclaiming memory and CPU cycles.
        const mount = document.getElementById('player-mount');
        if (mount) {
          mount.innerHTML = `<div id="terminal-status-msg" class="flex h-full w-full flex-col items-center justify-center gap-3 bg-zinc-950 text-center">${LOADER_INNER_HTML}</div>`;
        }

        const globalPlayer = document.getElementById('global-cyber-player') || this.el;
        if (globalPlayer) {
          withNoTransition(globalPlayer, () => {
            globalPlayer.classList.remove('is-slotted', 'is-pip');
            globalPlayer.classList.add('is-hidden');
            document.body.appendChild(globalPlayer); // Move back to body
          });
        }
        
        setPlayerStorage(PLAYER_STORAGE_KEYS.PLAYING, 'false');
      },

      // WHY: Whenever the YouTube iframe is physically moved/re-parented in the DOM, 
      // the browser automatically destroys and recreates the iframe. This makes the existing YT.Player instance dead.
      // We call this helper to cleanly destroy the dead instance and rebuild a fresh YT.Player matching the current timeline offset.
      recreateYTPlayer: function() {
        if (!this.playlistData || !this.currentVideoId) return;
        const activeVideo = this.playlistData.schedule.find(p => p.id === this.currentVideoId);
        if (activeVideo) {
          const now = Math.floor(Date.now() / 1000);
          const pos = now % this.playlistData.totalLoopDuration;
          const offset = pos - activeVideo.start;
          
          // Force destruction before mounting to ensure we bypass any early return checks!
          if (this.player && this.player.destroy) {
            try { this.player.destroy(); } catch (e) {}
          }
          this.player = null;
          
          this.mountVideo(activeVideo, offset);
        }
      },

      // -- CORE UI LOGIC PORTED --
      // WHY: Wires up all internal DOM events for the global player (mute, volume, pip button, etc). 
      // These are scoped strictly to the global player DOM to prevent polluting the rest of the app.
      setupUI: function() {
        const self = this;
        const storedVolume = getPlayerStorage(PLAYER_STORAGE_KEYS.VOLUME);

        if (storedVolume !== null) {
          self.currentVolume = parseInt(storedVolume, 10);
        }
        
        // ALWAYS start muted on reload/refresh as requested by the user
        self.isMuted = true;

        // WHY: Intercept clicks on the Cybernati logo to smoothly navigate via Swup on the live website (which preserves playing audio), while allowing normal target="_top" navigation when embedded inside an iframe (like in Obsidian).
        const logoLink = document.querySelector('#global-cyber-player .cyber-header a');
        if (logoLink) {
          logoLink.onclick = (e) => {
            if (window.location.pathname.includes('/player/')) return;
            e.preventDefault();
            
            // Ensure player goes into PiP when navigating to the homepage via logo click
            if (!self.isFloating) {
              const gp = document.getElementById('global-cyber-player') || self.el;
              gp.classList.remove('is-slotted');
              gp.classList.add('is-pip');
              document.body.appendChild(gp);
              self.isFloating = true;
            }
            
            const href = logoLink.getAttribute('href');
            if (window.swup) window.swup.navigate(href);
            else window.location.href = href;
          };
        }

        const { updateVolumeState, syncVolumeDOM, fadeVolume } = this.setupVolumeControls();

        this.setupPipControls();

        const { closeAllPanels } = this.setupPanelControls();

        const clickOverlay = document.getElementById('player-click-overlay');
        if (clickOverlay) {
          clickOverlay.onclick = (e) => {
            handleInteraction(e);
            // WHY: If the user was just dragging the PiP window, we ignore the click event so it doesn't accidentally play/pause the video!
            if (self.wasDragged) {
              self.wasDragged = false;
              return;
            }
            if (self.player && self.player.getPlayerState) {
              const state = self.player.getPlayerState();
              if (state === 1) self.player.pauseVideo();
              else self.player.playVideo();
            }
          };
          clickOverlay.ondblclick = () => {
            const fsBtn = document.getElementById('fullscreen-toggle');
            if (fsBtn) fsBtn.click();
          };
        }

        // PiP controls are initialized by setupPipControls above

        this.setupDragAndResize();

        const pipBtn = document.getElementById('pip-btn');
        if (pipBtn) {
          pipBtn.onclick = () => {
            if (self.isFloating) {
              // Return to slot
              self.isManuallyPip = false;
              self.isFloating = false;
              self.checkSlotAndMount();
            } else {
              // Force float (PiP)
              self.isManuallyPip = true;
              self.isFloating = true;
              self.checkSlotAndMount();
            }
          };
        }

        const fsBtn = document.getElementById('fullscreen-toggle');
        if (fsBtn) {
          fsBtn.onclick = () => {
            const root = document.getElementById('player-root');
            if (!document.fullscreenElement) root.requestFullscreen();
            else document.exitFullscreen();
          };
        }

        const desyncBtn = document.getElementById('desync-btn');
        const desyncText = document.getElementById('desync-text');
        if (desyncBtn && desyncText) {
          desyncBtn.onclick = () => {
            self.isDesynced = !self.isDesynced;
            if (self.isDesynced) {
              desyncBtn.classList.add('is-active');
              desyncBtn.classList.add('border-highlight-500', 'text-highlight-300', 'bg-highlight-950/20');
              desyncBtn.classList.remove('border-zinc-800', 'bg-zinc-900/60');
              desyncText.textContent = "Sync Feed";
              if (self.updateTimer) clearInterval(self.updateTimer);
              if (self.player) { try { self.player.destroy(); } catch (e) {} self.player = null; }
              self.startDesyncSequence();
            } else {
              desyncBtn.classList.remove('is-active');
              desyncBtn.classList.remove('border-highlight-500', 'text-highlight-300', 'bg-highlight-950/20');
              desyncBtn.classList.add('border-zinc-800', 'bg-zinc-900/60');
              desyncText.textContent = "Desync";
              if (self.desyncTimer) clearInterval(self.desyncTimer);
              self.startLoop();
            }
          };
        }


        
        // Synchronize initial muted UI volume elements immediately on page load
        syncVolumeDOM();

        this.setupHotkeys(updateVolumeState, closeAllPanels);

        // WHY: Wires up the auto-hide controls to smoothly reveal header/footer overlays on interaction and auto-fade on inactivity.
        self.setupOverlaysAutoHide();
      },

      setupOverlaysAutoHide: function() {
        const self = this;
        const player = document.getElementById('global-cyber-player') || this.el;
        const root = document.getElementById('player-root');
        const header = document.querySelector('#global-cyber-player .cyber-header');
        const footer = document.querySelector('#global-cyber-player .cyber-footer');
        if (!player || !root || !header || !footer) return;

        // WHY: Cache overlay panels at setup to eliminate heavy getElementById DOM tree traversals
        // inside high-frequency mousemove event loops.
        const notesPanel = document.getElementById('related-notes-panel');
        const sharePanel = document.getElementById('share-panel');
        const queuePanel = document.getElementById('queue-panel');

        let inactivityTimeout = null;

        const isAnyPanelOpen = () => {
          return (notesPanel && notesPanel.classList.contains('opacity-100')) ||
                 (sharePanel && sharePanel.classList.contains('opacity-100')) ||
                 (queuePanel && queuePanel.classList.contains('opacity-100'));
        };

        const showControls = () => {
          header.classList.add('is-visible');
          footer.classList.add('is-visible');
          player.classList.remove('hide-cursor');
          if (root) root.classList.remove('hide-cursor');
          
          if (inactivityTimeout) clearTimeout(inactivityTimeout);
          
          // Auto-hide controls only if the video is playing and no overlay panel is open
          const isPlaying = getPlayerStorage(PLAYER_STORAGE_KEYS.PLAYING) === 'true';
          if (isPlaying) {
            inactivityTimeout = setTimeout(() => {
              if (!isAnyPanelOpen()) {
                hideControls();
              }
            }, 3000); // 3 seconds timeout
          }
        };

        const hideControls = () => {
          if (isAnyPanelOpen()) return;
          header.classList.remove('is-visible');
          footer.classList.remove('is-visible');
          player.classList.add('hide-cursor');
          if (document.fullscreenElement && root) {
            root.classList.add('hide-cursor');
          }
        };

        // Reveal on mouse move, clicks, touch, or keyboard navigation inside the player bounds
        player.addEventListener('mousemove', showControls, { passive: true });
        player.addEventListener('click', showControls, { passive: true });
        player.addEventListener('touchstart', showControls, { passive: true });
        player.addEventListener('keydown', showControls, { passive: true });

        // Faster fade out (1.2 seconds) on mouseleave to provide clean, snappier visuals when leaving the player
        player.addEventListener('mouseleave', () => {
          const isPlaying = getPlayerStorage(PLAYER_STORAGE_KEYS.PLAYING) === 'true';
          if (!isPlaying) return; // Keep visible if not playing
          if (inactivityTimeout) clearTimeout(inactivityTimeout);
          inactivityTimeout = setTimeout(() => {
            if (!isAnyPanelOpen()) {
              hideControls();
            }
          }, 1200);
        }, { passive: true });

        // Force reveal immediately whenever trigger buttons are clicked to support fluid overlay usage
        const triggers = ['notes-trigger-btn', 'share-trigger-btn', 'queue-trigger-btn'];
        triggers.forEach(id => {
          const btn = document.getElementById(id);
          if (btn) {
            btn.addEventListener('click', () => {
              showControls();
              if (inactivityTimeout) clearTimeout(inactivityTimeout);
            }, { passive: true });
          }
        });

        // Listen for browser fullscreen transitions to seamlessly sync states
        document.addEventListener('fullscreenchange', () => {
          showControls();
        }, { passive: true });

        // Trigger initial reveal/sync on startup
        showControls();
      },

      // WHY: The core feature of Cybernati is that all users visiting a playlist are watching the exact same video at the exact same timestamp.
      // It's a "live broadcast" simulation. We use the server-generated timeline and compare it against the current Unix time.
      startLoop: function() {
        if (!this.playlistData) return;
        const { totalLoopDuration, schedule, interstitials } = this.playlistData;
        if (!schedule || schedule.length === 0) return;
        const self = this;
        
        // WHY: Cache these four elements before the interval starts to avoid querying the DOM
        // four times per second on every tick of the update loop.
        const progressBar = document.getElementById('sync-progress');
        const titleEl = document.getElementById('video-title');
        const pipTitleEl = document.getElementById('pip-video-title');
        const nextEl = document.getElementById('next-title');
        
        const update = () => {
          if (self.isDesynced) return;
          const now = Math.floor(Date.now() / 1000);
          const pos = now % totalLoopDuration;
          
          let active = null, standby = true, wait = 0, offset = 0, nextIndex = 0;
          for (let i = 0; i < schedule.length; i++) {
            const p = schedule[i];
            if (pos >= p.start && pos < p.end) {
              active = p; standby = false; offset = pos - p.start;
              nextIndex = (i + 1) % schedule.length; break;
            }
            if (pos >= p.end && (i === schedule.length - 1 || pos < schedule[i+1].start)) {
              standby = true; wait = (i === schedule.length - 1) ? (totalLoopDuration - pos) : (schedule[i+1].start - pos);
              nextIndex = (i + 1) % schedule.length; break;
            }
          }
          
          if (!standby && active) {
            if (progressBar) progressBar.style.width = `${((offset / active.duration) * 100)}%`;
            if (titleEl) titleEl.innerHTML = active.title.toUpperCase();
            if (pipTitleEl) pipTitleEl.innerHTML = active.title.toUpperCase();
            if (nextEl) nextEl.innerHTML = schedule[nextIndex].title.toUpperCase();
            
            if (self.currentVideoId !== active.id) {
              self.mountVideo(active, offset);
              self.renderQueue();
            }
            else if (self.player && self.player.getCurrentTime) {
              const drift = Math.abs(self.player.getCurrentTime() - offset);
              if (drift > 3) self.player.seekTo(offset, true);
            }
          } else {
            if (progressBar) progressBar.style.width = `${Math.min(100, (wait / 30) * 100)}%`;
            if (titleEl) titleEl.innerHTML = "SIGNAL LOST: TRANSMITTING STANDBY...";
            if (pipTitleEl) pipTitleEl.innerHTML = "SIGNAL LOST: STANDBY";
            if (nextEl) nextEl.innerHTML = schedule[nextIndex].title.toUpperCase();
            self.mountStandby(interstitials);
          }
        };

        if (this.updateTimer) clearInterval(this.updateTimer);
        this.updateTimer = setInterval(update, 1000);
        update();
      },

      // WHY: Sometimes users don't want to watch the live broadcast, they just want to flip through random videos.
      // This stops the synchronized updateTimer and plays random clips from the playlist for 5 minutes at a time.
      startDesyncSequence: function() {
        const { schedule, interstitials } = this.playlistData;
        if (!schedule || schedule.length === 0) return;
        const self = this;
        
        const playRandom = () => {
          const index = Math.floor(Math.random() * schedule.length);
          const prog = schedule[index];
          const playWindow = Math.min(prog.duration, 300);
          const startAt = prog.duration > 300 ? Math.floor(Math.random() * (prog.duration - playWindow)) : 0;
          
          self.mountVideo(prog, startAt);
          self.renderQueue();
          let remaining = playWindow;
          
          if (self.desyncTimer) clearInterval(self.desyncTimer);
          self.desyncTimer = setInterval(() => {
            if (!self.isDesynced) { clearInterval(self.desyncTimer); return; }
            remaining--;
            const progressBar = document.getElementById('sync-progress');
            if (progressBar) progressBar.style.width = `${((remaining / playWindow) * 100)}%`;
            
            if (remaining <= 0) {
              clearInterval(self.desyncTimer);
              self.mountStandby(interstitials);
              setTimeout(playRandom, 10000);
            }
          }, 1000);
        };
        playRandom();
      },

      // WHY: When a new video starts on the broadcast schedule, we destroy the old YouTube iframe and create a new one.
      // We seek to the exactly calculated offset so that the client joins perfectly in-sync with the global schedule.
      mountVideo: function(prog, offset) {
        const self = this;
        this._activeProgram = prog;
        const mount = document.getElementById('player-mount');
        if (!mount) return;

        // Update both standard and PiP titles immediately
        const titleEl = document.getElementById('video-title');
        const pipTitleEl = document.getElementById('pip-video-title');
        if (titleEl) titleEl.innerHTML = prog.title.toUpperCase();
        if (pipTitleEl) pipTitleEl.innerHTML = prog.title.toUpperCase();

        if (this.currentVideoId === prog.id && this.player && this.player.getPlayerState && this.player.getPlayerState() > 0) return;
        
        this.currentVideoId = prog.id;
        this.currentInterstitialIndex = null;

        // Ensure playing state is saved when mounting video
        setPlayerStorage(PLAYER_STORAGE_KEYS.PLAYING, 'true');

        // WHY: We defer loading the YouTube script API and player creation until the video actually needs to be mounted.
        // This keeps other pages snappy and prevents external scripts from loading on every standard page view.
        this.ensureYoutubeAPI(() => {
          // Double check that we are still supposed to play this exact video
          if (this.currentVideoId !== prog.id) return;
          
          if (this.player && this.player.destroy) { try { this.player.destroy(); } catch (e) {} }
          this.player = null;
          
          // WHY: Mount the video player behind a frosted loading overlay to prevent a sudden visual black screen/flash.
          // The overlay displays a thematic "Aligning Remote Feed Nodes..." text and is faded out smoothly once
          // the video stream has initialized and successfully started playing.
          mount.innerHTML = `
            <div id="yt-player" class="h-full w-full absolute inset-0"></div>
            <div id="player-loading-overlay" class="absolute inset-0 flex h-full w-full flex-col items-center justify-center gap-3 bg-zinc-950 text-center z-10" style="transition: opacity 0.3s ease;">
              <!-- TO REVERT TO ORIGINAL CIRCULAR SPINNER: Comment out the .cyber-logo-loader block below, and uncomment the standard spinner.
              <svg class="w-8 h-8 text-highlight-400 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" opacity="0.25"/>
                <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              -->
              ${LOADER_INNER_HTML}
            </div>
          `;

          // Helper function to fade out and clean up the loading overlay smoothly
          const removeOverlay = () => {
            const overlay = document.getElementById('player-loading-overlay');
            if (overlay) {
              overlay.style.opacity = '0';
              setTimeout(() => {
                if (overlay.parentNode) {
                  overlay.parentNode.removeChild(overlay);
                }
              }, 300);
            }
          };

          this.player = new window.YT.Player('yt-player', {
            height: '100%', width: '100%', videoId: prog.id,
            playerVars: { autoplay: 1, mute: 1, controls: 0, disablekb: 1, modestbranding: 1, rel: 0, start: Math.floor(offset) },
            events: {
              onReady: (e) => {
                if (self.isMuted) { e.target.mute(); }
                else { e.target.unMute(); e.target.setVolume(toLogVolume(self.currentVolume)); }
                e.target.playVideo(); // Force play to be safe
                // Fallback timeout to guarantee the loading screen is removed even on slower connections or strict autoplay block configurations
                setTimeout(removeOverlay, 1500);
              },
              onStateChange: (ev) => {
                // ev.data === 1 corresponds to YT.PlayerState.PLAYING
                if (ev.data === 1) {
                  removeOverlay();
                }
              }
            }
          });
        });        const linksEl = document.getElementById('related-links');
        const pipLinksEl = document.getElementById('pip-related-links');

        this.renderLinks(linksEl, prog, false);
        this.renderLinks(pipLinksEl, prog, true);
      },

      mountStandby: function(interstitials) {
        const mount = document.getElementById('player-mount');
        if (!mount || !interstitials || interstitials.length === 0) return;

        // Update both standard and PiP titles for standby
        const titleEl = document.getElementById('video-title');
        const pipTitleEl = document.getElementById('pip-video-title');
        if (titleEl) titleEl.innerHTML = "SIGNAL LOST: TRANSMITTING STANDBY...";
        if (pipTitleEl) pipTitleEl.innerHTML = "SIGNAL LOST: STANDBY";

        if (this.currentInterstitialIndex === null) this.currentInterstitialIndex = Math.floor(Math.random() * interstitials.length);

        let intUrl = interstitials[this.currentInterstitialIndex];
        if (intUrl.startsWith('/') && !intUrl.startsWith(base)) intUrl = base.replace(/\/$/, '') + intUrl;

        const existing = mount.querySelector('video');
        if (existing && existing.getAttribute('src') === intUrl) return;

        if (this.player && this.player.destroy) { try { this.player.destroy(); } catch (e) {} this.player = null; this.currentVideoId = null; }

        mount.innerHTML = `<video src="${intUrl}" autoplay muted loop style="width:100%; height:100%; object-fit:cover; background:black;"></video>`;

        const linksEl = document.getElementById('related-links');
        if (linksEl) linksEl.innerHTML = '<span class="text-sm text-zinc-500 uppercase italic">TRANSMITTING CYBERNATI SIGNAL INTERSTITIAL...</span>';

        const pipLinksEl = document.getElementById('pip-related-links');
        if (pipLinksEl) pipLinksEl.innerHTML = '<span class="text-xs text-zinc-500 uppercase italic">TRANSMITTING SIGNAL INTERSTITIAL...</span>';
      }
    };

    // WHY: Initialize the global player instantly on page load. Setup the listeners, MutationObserver, and Swup hooks
    // right away without waiting for external YouTube API scripts to load, which keeps the page load fast and responsive.
    window.CyberPlayer.initGlobal();

  })();
</script>
