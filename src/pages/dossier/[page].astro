---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import { siteConfig } from '@/config';
import { generatePostsListSEO } from '@/utils/seo';
import { shouldShowContent, sortPostsByDate, isValidDate, extractTags } from '@/utils/markdown';
import { resolveUrl } from '@/utils/url-helpers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import DossierCard from '@/components/DossierCard.astro';
import DossierTags from '@/components/DossierTags.astro';
import Pagination from '@/components/Pagination.astro';
import Icon from '@/components/Icon.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const allDossiers = await getCollection('dossier');
  const isDev = import.meta.env.DEV;
  const visibleDossiers = allDossiers.filter(dossier => shouldShowContent(dossier, isDev));
  const sortedDossiers = sortPostsByDate(visibleDossiers);

  const dossiersPerPage = siteConfig.postOptions.postsPerPage;
  const totalPages = Math.ceil(sortedDossiers.length / dossiersPerPage);

  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    paths.push({
      params: { page: page.toString() },
      props: {
        dossiers: sortedDossiers,
        currentPage: page,
        totalPages,
        dossiersPerPage
      }
    });
  }

  return paths;
};

export interface Props {
  dossiers: any[];
  currentPage: number;
  totalPages: number;
  dossiersPerPage: number;
}

const { dossiers, currentPage, totalPages, dossiersPerPage } = Astro.props;

// Calculate paginated dossiers
const startIndex = (currentPage - 1) * dossiersPerPage;
const endIndex = Math.min(startIndex + dossiersPerPage, dossiers.length);
const paginatedDossiers = dossiers.slice(startIndex, endIndex);

// Extract all unique tags
const allTags = extractTags(dossiers);

// Generate SEO data
const seoData = generatePostsListSEO(import.meta.env.SITE || '', undefined);
seoData.title = `Dossier - Page ${currentPage} | ${siteConfig.title}`;
seoData.description = `Page ${currentPage} of all dossiers on ${siteConfig.title}`;

// Pagination Info
const baseUrl = resolveUrl('/dossier');
const pagination = {
  currentPage,
  totalPages,
  hasNext: currentPage < totalPages,
  hasPrev: currentPage > 1,
  nextUrl: currentPage < totalPages ? resolveUrl(`/dossier/${currentPage + 1}`) : undefined,
  prevUrl: currentPage > 2 ? resolveUrl(`/dossier/${currentPage - 1}`) : resolveUrl('/dossier')
};
---

<BaseLayout seoData={seoData}>
  <div class="pt-4 pb-8 md:py-8 relative">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 mb-8 md:mb-12" style={`max-width: ${siteConfig.layout.contentWidth}`}>
      <!-- Page header -->
      <header class="mb-6 md:mb-8">
        <h1 class="text-lg font-bold text-primary-900 dark:text-primary-50 mb-3">
          Dossier
        </h1>
        <p class="text-primary-600 dark:text-primary-300">
          Page {currentPage} of {totalPages}
        </p>
      </header>

      <div class="relative">
        <!-- Main content -->
        <div class="max-w-none">
          {paginatedDossiers.length > 0 ? (
            <>
              <!-- Dossiers grid -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12 justify-items-center md:justify-items-stretch">
                {paginatedDossiers.map((dossier, index) => (
                  <DossierCard
                    dossier={dossier}
                    eager={index < 4}
                    context="dossier"
                  />
                ))}
              </div>

              <!-- Pagination component -->
              <Pagination pagination={pagination} baseUrl={baseUrl} />
            </>
          ) : (
            <div class="text-center py-12">
              <Icon name="folder-open" class="w-12 h-12 text-primary-300 dark:text-primary-600 mx-auto mb-4" />
              <h3 class="text-lg font-medium text-primary-900 dark:text-primary-50 mb-2">
                No dossiers on this page
              </h3>
              <p class="text-primary-600 dark:text-primary-300">
                Check back soon!
              </p>
            </div>
          )}
        </div>

        <!-- Mobile sidebar - appears below content on mobile/tablet -->
        <div class="xl:hidden mt-12 space-y-6">
          <!-- Tags -->
          {allTags.length > 0 && (
            <DossierTags tags={allTags} />
          )}
        </div>

        <!-- Desktop sidebar - floats to the right of the content container -->
        <div class="hidden xl:block absolute top-0 left-full ml-8 w-64 h-full">
          <div class="sticky top-24 pb-6 overflow-x-hidden overflow-y-auto" id="tags-sidebar" style="max-height: 60vh;">
            <!-- Tags -->
            {allTags.length > 0 && (
              <DossierTags tags={allTags} />
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>