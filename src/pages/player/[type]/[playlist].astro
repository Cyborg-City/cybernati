---
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';
import CybernatiPlayer from '@/components/CybernatiPlayer.astro';
import '@/styles/global.css';

// Define getStaticPaths for Astro SSG
export async function getStaticPaths() {
  const mediaDir = 'src/content/media';
  
  // Scrape files to find directories (playlists)
  const mediaItems = await getCollection('media');
  
  const playlists = new Set();
  
  // Add default playlist
  playlists.add('video/channel-000');
  
  for (const item of mediaItems) {
    // Expected id format: "type/playlistName/filename"
    const parts = item.id.split('/');
    if (parts.length >= 2) {
      const type = parts[0];
      const playlist = parts[1];
      playlists.add(`${type}/${playlist}`);
    }
  }

  return Array.from(playlists).map((playlistKey) => {
    const [type, playlist] = (playlistKey as string).split('/');
    return {
      params: { type, playlist },
      props: { type, playlist }
    };
  });
}

const { type, playlist } = Astro.props;

// Construct absolute URL structures for social/Twitter embeds
const siteUrl = siteConfig.site; // e.g. "https://cyborg-city.github.io/cybernati/"
const cleanSite = siteUrl.endsWith('/') ? siteUrl.slice(0, -1) : siteUrl;
const absolutePlayerUrl = `${cleanSite}/player/${type}/${playlist}`;
const absoluteOgImage = `${cleanSite}/_assets/cover.3oPYsmhQ_Z1hN3LG.webp`; 

const pageTitle = `Cybernati Player | ${playlist.toUpperCase()}`;
const pageDescription = `Tune into the 24/7 client-synchronized Cybernati broadcast loop for playlist "${playlist}".`;
---

<!DOCTYPE html>
<html lang="en" class="h-full select-none bg-black overflow-hidden m-0 p-0">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>

  <!-- Open Graph / Twitter Cards -->
  <meta property="og:type" content="video.other" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={absolutePlayerUrl} />
  <meta property="og:image" content={absoluteOgImage} />
  
  <meta name="twitter:card" content="player" />
  <meta name="twitter:site" content={`@${siteConfig.author}`} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:player" content={absolutePlayerUrl} />
  <meta name="twitter:player:width" content="640" />
  <meta name="twitter:player:height" content="360" />
  <meta name="twitter:image" content={absoluteOgImage} />
  
  <!-- Premium Outfit Font, JetBrains Mono, Special Elite, and Courier Prime for Cybernati aesthetics -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=JetBrains+Mono:wght@400;700&family=Special+Elite&family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
  
  <!-- Google Icons (Material Symbols Outlined) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <style>
    /* Styling utilizing site theme values dynamically */
    :root {
      --cyber-primary: #a78bfa; 
      --cyber-primary-rgb: 167, 139, 250;
      --cyber-highlight: #ff4d4d; 
      --font-outfit: 'Outfit', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-courier-prime: 'Courier Prime', monospace;
    }
    
    body {
      font-family: var(--font-outfit);
      background-color: #030303;
      color: #e4e4e7;
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden; /* Hide scrollbars so the player takes over cleanly */
    }
  </style>
</head>
<body>
  <!-- The Global Player Component -->
  <CybernatiPlayer />

  <!-- The Slot for the Player Component to mount into. 
       Because this is a standalone iframe page (for Obsidian embeds or direct links), 
       the player component will instantly snap into this slot instead of floating. -->
  <div id="cyber-player-slot" data-type={type} data-playlist={playlist} class="w-full h-full"></div>
</body>
</html>
