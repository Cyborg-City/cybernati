---
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config';

// Define getStaticPaths for Astro SSG
export async function getStaticPaths() {
  const mediaDir = 'src/content/media';
  
  // Scrape files to find directories (playlists)
  const mediaItems = await getCollection('media');
  
  const playlists = new Set();
  
  // Add default playlist
  playlists.add('video/channel-000');
  
  for (const item of mediaItems) {
    // Expected id format: "type/playlistName/filename"
    const parts = item.id.split('/');
    if (parts.length >= 2) {
      const type = parts[0];
      const playlist = parts[1];
      playlists.add(`${type}/${playlist}`);
    }
  }

  return Array.from(playlists).map((playlistKey) => {
    const [type, playlist] = (playlistKey as string).split('/');
    return {
      params: { type, playlist },
      props: { type, playlist }
    };
  });
}

import { getBaseUrl } from '@/utils/url-helpers';

const { type, playlist } = Astro.props;
const base = getBaseUrl();

// Construct absolute URL structures for social/Twitter embeds
const siteUrl = siteConfig.site; // e.g. "https://cyborg-city.github.io/cybernati/"
const cleanSite = siteUrl.endsWith('/') ? siteUrl.slice(0, -1) : siteUrl;
const absolutePlayerUrl = `${cleanSite}/player/${type}/${playlist}`;
const absoluteOgImage = `${cleanSite}/_assets/cover.3oPYsmhQ_Z1hN3LG.webp`; 

const pageTitle = `Cybernati Player | ${playlist.toUpperCase()}`;
const pageDescription = `Tune into the 24/7 client-synchronized Cybernati broadcast loop for playlist "${playlist}".`;
---

<!DOCTYPE html>
<html lang="en" class="h-full select-none bg-black">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="video.other" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={absolutePlayerUrl} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:video" content={absolutePlayerUrl} />
  <meta property="og:video:width" content="640" />
  <meta property="og:video:height" content="360" />

  <!-- Twitter / X Player Card -->
  <meta name="twitter:card" content="player" />
  <meta name="twitter:site" content={`@${siteConfig.author}`} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:player" content={absolutePlayerUrl} />
  <meta name="twitter:player:width" content="640" />
  <meta name="twitter:player:height" content="360" />
  <meta name="twitter:image" content={absoluteOgImage} />
  
  <!-- Premium Outfit Font, JetBrains Mono, Special Elite, and Courier Prime for Cybernati aesthetics -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700&family=JetBrains+Mono:wght@400;700&family=Special+Elite&family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
  
  <!-- Google Icons (Material Symbols Outlined) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  <style>
    /* Styling utilizing site theme values dynamically */
    :root {
      --cyber-primary: #a78bfa; /* Lavender primary default */
      --cyber-primary-rgb: 167, 139, 250;
      --cyber-highlight: #ff4d4d; /* Coral red accent */
      --font-outfit: 'Outfit', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-courier-prime: 'Courier Prime', monospace;
    }
    
    body {
      font-family: var(--font-outfit);
      background-color: #030303;
      color: #e4e4e7;
    }

    /* Premium Glassmorphic Controls */
    .glass-panel {
      background: rgba(10, 10, 12, 0.7);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    /* Sleek Cybernati progress bar */
    .progress-bar-fill {
      background: linear-gradient(90deg, var(--cyber-primary) 0%, #c084fc 100%);
      box-shadow: 0 0 12px rgba(var(--cyber-primary-rgb), 0.5);
      transition: width 1s linear;
    }

    /* Custom thin scrollbars for lists */
    .custom-scroll::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.2);
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 2px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(var(--cyber-primary-rgb), 0.3);
    }

    /* Google Icons fill transition */
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      transition: font-variation-settings 0.1s ease;
    }
    button:hover .material-symbols-outlined {
      font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24;
    }

    /* Floating PIP Container fallback style */
    .floating-pip-container {
      position: fixed;
      bottom: 20px;
      right: 20px;
      width: 320px;
      height: 180px;
      z-index: 9999;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
      border-radius: 8px;
      overflow: hidden;
      border: 2px solid var(--cyber-primary);
    }

    /* Pip mode override when embedded in a small parent float panel */
    body.pip-mode header,
    body.pip-mode footer,
    body.pip-mode #related-notes-panel {
      display: none !important;
    }
    body.pip-mode #player-root {
      padding: 0 !important;
    }
    body.pip-mode #player-viewport {
      border: none !important;
      border-radius: 0 !important;
      height: 100% !important;
      width: 100% !important;
    }
    
    /* Custom PiP overlay volume and restore controls */
    #pip-controls-overlay {
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease, transform 0.25s ease;
      transform: translateY(5px);
    }
    
    body.pip-mode #player-viewport:hover #pip-controls-overlay {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  </style>
</head>
<body class="flex h-full flex-col overflow-hidden text-zinc-200">
  <!-- WHY: Synchronously check if we are in PiP mode on initial load.
       This prevents "flash of unstyled content" (FOUC) where the iframe briefly renders
       the entire player UI inside a small floating viewport during iframe reloading. -->
  <script is:inline>
    try {
      if (window !== window.parent && window.parent.cyberPlayerContainer && window.parent.cyberPlayerContainer.classList.contains('floating-pip-iframe-container')) {
        document.body.classList.add('pip-mode');
      }
    } catch (e) {}
  </script>
  
  <div id="player-root" class="relative flex h-full w-full flex-col p-4 box-sizing-border-box">
    
    <!-- Top Header: Dynamic playing title & Cybernati branding -->
    <header class="glass-panel mb-3 flex items-center justify-between rounded-xl px-4 py-2 shadow-lg">
      <div class="flex items-center">
        <h1 id="video-title" class="text-sm font-semibold tracking-wide text-zinc-100 uppercase truncate max-w-[280px] sm:max-w-[420px]" style="font-family: var(--font-courier-prime)">
          SCANNING FOR SIGNAL...
        </h1>
      </div>
      <div class="flex items-center gap-2">
        <a href={base} target="_top" class="text-sm md:text-base font-bold tracking-wide text-purple-400 hover:text-purple-300 transition-colors" style="font-family: 'Special Elite', cursive;">CYBERNATI™</a>
      </div>
    </header>

    <!-- Main Viewport: The YouTube Video player -->
    <main id="player-viewport" class="relative flex-grow rounded-2xl border border-zinc-900 bg-black overflow-hidden shadow-2xl">
      <div id="player-mount" class="h-full w-full">
        <!-- Standby Signal message during initialization -->
        <div id="terminal-status-msg" class="flex h-full w-full flex-col items-center justify-center gap-3 bg-zinc-950 text-center">
          <span class="material-symbols-outlined text-4xl animate-spin text-purple-400">sync</span>
          <span class="text-xs uppercase tracking-widest text-zinc-400" style="font-family: var(--font-mono)">Aligning Remote Feed Nodes...</span>
        </div>
      </div>

      <!-- Sync Progress Bar running cleanly across viewport bottom -->
      <div id="progress-container" class="absolute bottom-0 left-0 w-full h-[3px] bg-zinc-900 z-10" aria-label="Media play progress">
        <div id="sync-progress" class="progress-bar-fill h-full w-0"></div>
      </div>

      <!-- PiP Hover Controls Overlay -->
      <div id="pip-controls-overlay" class="absolute bottom-3 left-1/2 -translate-x-1/2 z-30 flex items-center justify-center rounded-lg border border-zinc-800 bg-zinc-950/90 backdrop-blur-md px-2.5 py-1.5 opacity-0 pointer-events-none transition-all duration-300 shadow-xl border border-white/5 w-auto">
        <div class="flex items-center gap-1.5">
          <button id="pip-mute-toggle" class="flex items-center justify-center rounded p-1 text-zinc-400 hover:bg-zinc-800 hover:text-purple-400" aria-label="Toggle mute state">
            <span id="pip-volume-icon-symbol" class="material-symbols-outlined text-base">volume_off</span>
          </button>
          <input type="range" id="pip-volume-control" class="h-1 w-14 cursor-pointer accent-purple-400 bg-zinc-800 rounded-lg appearance-none" min="0" max="100" value="0" aria-label="Volume Slider" />
        </div>
      </div>
    </main>

    <!-- Collapsible Related Notes overlay (renders above header and bottom controls) -->
    <div id="related-notes-panel" class="absolute bottom-[92px] left-4 right-4 z-50 rounded-2xl glass-panel shadow-2xl max-h-0 overflow-hidden transition-all duration-300 ease-in-out opacity-0">
      <div class="p-4 flex flex-col gap-3">
        <div class="flex items-center justify-between border-b border-zinc-800 pb-2">
          <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-400" style="font-family: var(--font-mono)">Related Notes</span>
          <button id="close-notes-btn" class="flex items-center justify-center rounded p-1 text-zinc-400 hover:bg-zinc-800 hover:text-white" aria-label="Close notes panel">
            <span class="material-symbols-outlined text-sm">close</span>
          </button>
        </div>
        <div id="related-links" class="flex flex-wrap gap-2 max-h-[160px] overflow-y-auto custom-scroll pr-1 text-zinc-300">
          <!-- Populated dynamically via JS -->
          <span class="text-xs text-zinc-500 uppercase italic">No related vault notes detected.</span>
        </div>
      </div>
    </div>

    <!-- Interactive Bottom Controls Bar -->
    <footer class="glass-panel mt-3 flex flex-col gap-2 rounded-xl p-3 shadow-lg">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        
        <!-- Upcoming track info -->
        <div class="flex items-center gap-2 overflow-hidden">
          <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-500" style="font-family: var(--font-mono)">Next:</span>
          <span id="next-title" class="truncate text-xs font-semibold text-zinc-300 max-w-[200px]" style="font-family: var(--font-mono)">STANDBY</span>
        </div>

        <!-- Toolbar Buttons -->
        <div class="flex items-center justify-between sm:justify-end gap-3 flex-wrap">
          
          <!-- Related Notes Trigger -->
          <button id="notes-trigger-btn" class="flex items-center gap-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 px-3 py-1.5 text-xs font-medium text-zinc-300 hover:border-purple-500 hover:bg-purple-950/20 hover:text-purple-300" aria-label="Open related Obsidian notes">
            <span class="material-symbols-outlined text-sm">menu_book</span>
            <span>Vault Notes</span>
          </button>

          <!-- Sync/Desync Mode Toggle -->
          <button id="desync-btn" class="flex items-center gap-1.5 rounded-lg border border-zinc-800 bg-zinc-900/60 px-3 py-1.5 text-xs font-medium text-zinc-300 hover:border-red-500 hover:bg-red-950/20 hover:text-red-300" aria-label="Switch between broadcast and on-demand mode">
            <span class="material-symbols-outlined text-sm">podcasts</span>
            <span id="desync-text">Desync</span>
          </button>

          <div class="flex items-center gap-1">
            <!-- Mute/Volume controls -->
            <button id="mute-toggle" class="flex items-center justify-center rounded-lg p-2 text-zinc-400 hover:bg-zinc-800 hover:text-purple-400" aria-label="Toggle mute state" aria-checked="true">
              <span id="volume-icon-symbol" class="material-symbols-outlined text-lg">volume_off</span>
            </button>
            <input type="range" id="volume-control" class="h-1 w-16 cursor-pointer accent-purple-400 bg-zinc-800 rounded-lg appearance-none" min="0" max="100" value="0" aria-label="Volume Slider" />
          </div>

          <div class="flex items-center gap-1">
            <!-- PiP Control -->
            <button id="pip-btn" class="flex items-center justify-center rounded-lg p-2 text-zinc-400 hover:bg-zinc-800 hover:text-purple-400" title="Picture in Picture (Or double-right-click video for browser PiP)" aria-label="Enable Picture-in-Picture">
              <span class="material-symbols-outlined text-lg">picture_in_picture_alt</span>
            </button>

            <!-- Fullscreen Control -->
            <button id="fullscreen-toggle" class="flex items-center justify-center rounded-lg p-2 text-zinc-400 hover:bg-zinc-800 hover:text-purple-400" title="Fullscreen" aria-label="Toggle full screen">
              <span class="material-symbols-outlined text-lg">fullscreen</span>
            </button>
          </div>

        </div>
      </div>
    </footer>

  </div>

  <script define:vars={{ type, playlist, base }}>
    // Self-contained broadcast client synchronization logic
    (function() {
      // Clean up any existing instances to prevent memory leaks during Swup transitions
      if (window.CyberPlayer) { window.CyberPlayer.destroy(); }

      window.CyberPlayer = {
        player: null,
        currentVolume: 0,
        isMuted: true,
        isDesynced: false,
        handshakeEstablished: false,
        updateTimer: null,
        desyncTimer: null,
        currentVideoId: null,
        playlistData: null,
        currentInterstitialIndex: null,

        destroy: function() {
          if (this.updateTimer) clearInterval(this.updateTimer);
          if (this.desyncTimer) clearInterval(this.desyncTimer);
          if (this.player && this.player.destroy) {
            try { this.player.destroy(); } catch (e) {}
          }
          this.player = null;
          this.currentVideoId = null;
          const mount = document.getElementById('player-mount');
          if (mount) {
            mount.innerHTML = `
              <div class="flex h-full w-full flex-col items-center justify-center gap-3 bg-zinc-950 text-center">
                <span class="material-symbols-outlined text-4xl animate-spin text-purple-400">sync</span>
                <span class="text-xs uppercase tracking-widest text-zinc-400" style="font-family: var(--font-mono)">Aligning Remote Feed Nodes...</span>
              </div>`;
          }
        },

        init: async function() {
          try {
            // Get current base route for playlist fetching
            const hostPath = window.location.origin;
            const cleanBase = base.endsWith('/') ? base : base + '/';
            const playlistUrl = `${hostPath}${cleanBase}api/playlists/${type}/${playlist}.json?v=${Date.now()}`;
            
            const response = await fetch(playlistUrl);
            if (!response.ok) throw new Error("Playlist file missing.");
            this.playlistData = await response.json();
            
            this.setupUI();
            this.startLoop();
          } catch (e) {
            console.error("Player initialization failure:", e);
            const status = document.getElementById('terminal-status-msg');
            if (status) {
              status.innerHTML = `
                <span class="material-symbols-outlined text-4xl text-red-500">dangerous</span>
                <span class="text-xs uppercase tracking-widest text-red-400" style="font-family: var(--font-mono)">Feed Node Offline: 404</span>`;
            }
          }
        },

        setupUI: function() {
          const self = this;

          // Load volume/mute states from localStorage
          const storedVolume = localStorage.getItem('cyber-player-volume');
          const storedMuted = localStorage.getItem('cyber-player-muted');
          const isRestoring = localStorage.getItem('cyber-player-restoring-pip') === 'true';

          // Clear restoring flag immediately so subsequent fresh loads start muted
          if (isRestoring) {
            localStorage.removeItem('cyber-player-restoring-pip');
          }

          // Check if we are inside the floated parent PiP container
          const isPip = window !== window.parent && window.parent.cyberPlayerContainer && window.parent.cyberPlayerContainer.classList.contains('floating-pip-iframe-container');

          if (storedVolume !== null) {
            self.currentVolume = parseInt(storedVolume, 10);
          } else {
            self.currentVolume = 25; // default volume
          }

          // Strict Autoplay Compliance:
          // Always initialize as muted on a fresh tab load (non-PiP) to prevent browsers from blocking playback.
          // Bypasses: 
          // 1. If the player was just restored back into the page from PiP mode!
          // 2. If we are currently floating in PiP mode.
          if (isRestoring) {
            self.isMuted = false;
            self.handshakeEstablished = true;
            localStorage.setItem('cyber-player-muted', 'false');
          } else if (isPip) {
            self.isMuted = storedMuted === 'true';
            self.handshakeEstablished = true;
          } else {
            self.isMuted = true;
            self.handshakeEstablished = false;
          }

          // Synchronizes all Volume Sliders, Buttons, and Icons in the DOM (Main & PiP controls)
          const syncVolumeDOM = () => {
            const volIcon = document.getElementById('volume-icon-symbol');
            const volControl = document.getElementById('volume-control');
            const muteBtn = document.getElementById('mute-toggle');

            const pipVolIcon = document.getElementById('pip-volume-icon-symbol');
            const pipVolControl = document.getElementById('pip-volume-control');
            const pipMuteBtn = document.getElementById('pip-mute-toggle');

            const symbol = self.isMuted ? 'volume_off' : (self.currentVolume > 50 ? 'volume_up' : 'volume_down');
            const sliderVal = self.isMuted ? 0 : self.currentVolume;

            // Sync main footer elements
            if (volIcon) volIcon.textContent = symbol;
            if (volControl) volControl.value = sliderVal;
            if (muteBtn) {
              muteBtn.setAttribute('aria-checked', self.isMuted ? 'true' : 'false');
              if (self.isMuted) {
                muteBtn.classList.remove('text-purple-400');
              } else {
                muteBtn.classList.add('text-purple-400');
              }
            }

            // Sync PiP hover overlay elements
            if (pipVolIcon) pipVolIcon.textContent = symbol;
            if (pipVolControl) pipVolControl.value = sliderVal;
            if (pipMuteBtn) {
              pipMuteBtn.setAttribute('aria-checked', self.isMuted ? 'true' : 'false');
              if (self.isMuted) {
                pipMuteBtn.classList.remove('text-purple-400');
              } else {
                pipMuteBtn.classList.add('text-purple-400');
              }
            }
          };

          // Handles the logical state update, localStorage persistence, and active player controls
          const updateVolumeState = (muted, volume) => {
            self.isMuted = muted;
            if (volume !== undefined) {
              self.currentVolume = volume;
            }

            localStorage.setItem('cyber-player-muted', self.isMuted ? 'true' : 'false');
            localStorage.setItem('cyber-player-volume', self.currentVolume);

            if (self.player) {
              if (self.isMuted) {
                if (self.player.mute) self.player.mute();
              } else {
                if (self.player.unMute) self.player.unMute();
                if (self.player.setVolume) self.player.setVolume(self.currentVolume);
              }
            }

            syncVolumeDOM();
          };

          // 1. Interactive User Handshake (To unmute automatically on first click)
          const handleInteraction = () => {
            if (self.handshakeEstablished) return;
            self.handshakeEstablished = true;
            localStorage.setItem('cyber-player-handshake', 'true');
            
            // Restore unmuted preference from previous session upon first interaction!
            const previouslyMuted = localStorage.getItem('cyber-player-muted') === 'true';
            if (!previouslyMuted) {
              updateVolumeState(false, self.currentVolume || 25);
            } else {
              updateVolumeState(true, self.currentVolume || 25);
            }
          };
          window.addEventListener('click', handleInteraction, { once: true });

          // 2. Main Mute Toggle
          const muteBtn = document.getElementById('mute-toggle');
          if (muteBtn) {
            muteBtn.onclick = () => {
              const nextMuted = !self.isMuted;
              let nextVol = self.currentVolume;
              if (!nextMuted && self.currentVolume === 0) {
                nextVol = 25;
              }
              updateVolumeState(nextMuted, nextVol);
            };
          }

          // 3. Main Volume Control
          const volSlider = document.getElementById('volume-control');
          if (volSlider) {
            volSlider.oninput = (e) => {
              const val = parseInt(e.target.value, 10);
              updateVolumeState(val === 0, val);
            };
          }

          // 3b. PiP Overlay Mute Toggle
          const pipMuteBtn = document.getElementById('pip-mute-toggle');
          if (pipMuteBtn) {
            pipMuteBtn.onclick = () => {
              const nextMuted = !self.isMuted;
              let nextVol = self.currentVolume;
              if (!nextMuted && self.currentVolume === 0) {
                nextVol = 25;
              }
              updateVolumeState(nextMuted, nextVol);
            };
          }

          // 3c. PiP Overlay Volume Control
          const pipVolSlider = document.getElementById('pip-volume-control');
          if (pipVolSlider) {
            pipVolSlider.oninput = (e) => {
              const val = parseInt(e.target.value, 10);
              updateVolumeState(val === 0, val);
            };
          }

          // Run initial sync on load to display correct persisted values
          syncVolumeDOM();

          // 4. Related Notes Panel toggle
          const notesTrigger = document.getElementById('notes-trigger-btn');
          const closeNotes = document.getElementById('close-notes-btn');
          const notesPanel = document.getElementById('related-notes-panel');
          
          if (notesTrigger && notesPanel) {
            notesTrigger.onclick = () => {
              notesPanel.classList.toggle('max-h-0');
              notesPanel.classList.toggle('max-h-[300px]');
              notesPanel.classList.toggle('opacity-0');
              notesPanel.classList.toggle('opacity-100');
            };
          }
          if (closeNotes && notesPanel) {
            closeNotes.onclick = () => {
              notesPanel.classList.add('max-h-0');
              notesPanel.classList.remove('max-h-[300px]');
              notesPanel.classList.add('opacity-0');
              notesPanel.classList.remove('opacity-100');
            };
          }

          // 5. Picture in Picture Mode
          const pipBtn = document.getElementById('pip-btn');
          if (pipBtn) {
            // WHY: The custom PiP miniplayer relies on Swup page-navigation interceptors
            // and parent DOM reparenting. This is only possible if the player is embedded
            // in a parent page on the exact same origin.
            // If loaded directly in a tab (not embedded), or in a cross-origin embed,
            // we hide the button entirely because the floating container needs the parent page to survive.
            const isEmbedded = window.self !== window.top;
            let isSameOrigin = false;
            try {
              isSameOrigin = isEmbedded && window.parent.location.origin === window.location.origin;
            } catch (e) {
              // Accessing parent location from a third-party iframe throws a security DOMException
            }

            if (!isEmbedded || !isSameOrigin) {
              pipBtn.style.display = 'none';
            }

            pipBtn.onclick = async () => {
              // Direct user click establishes volume handshake and unmutes player immediately
              self.handshakeEstablished = true;
              localStorage.setItem('cyber-player-handshake', 'true');
              
              // Unmute and restore to previous non-zero volume (or default to 25)
              let targetVol = self.currentVolume;
              if (targetVol === 0) targetVol = 25;
              updateVolumeState(false, targetVol);

              const video = document.querySelector('#player-mount video');
              
              if (video) {
                // If it's a standby interstitial local video, use native PiP if supported
                try {
                  if (document.pictureInPictureElement) {
                    await document.exitPictureInPicture();
                  } else {
                    await video.requestPictureInPicture();
                  }
                } catch (e) {
                  // Fallback to floating
                  self.triggerPip();
                }
              } else {
                // If it's the YouTube iframe, invoke parent or in-place custom PiP
                self.triggerPip();
              }
            };
          }



          // 6. Fullscreen Mode
          const fsBtn = document.getElementById('fullscreen-toggle');
          if (fsBtn) {
            fsBtn.onclick = () => {
              const root = document.getElementById('player-root');
              if (!document.fullscreenElement) {
                root.requestFullscreen().catch(err => console.error("Fullscreen fail:", err));
              } else {
                document.exitFullscreen();
              }
            };
          }

          // 7. Sync / Desync Toggle
          const desyncBtn = document.getElementById('desync-btn');
          const desyncText = document.getElementById('desync-text');
          
          if (desyncBtn && desyncText) {
            desyncBtn.onclick = () => {
              self.isDesynced = !self.isDesynced;
              
              if (self.isDesynced) {
                desyncBtn.classList.add('border-purple-500', 'text-purple-300', 'bg-purple-950/20');
                desyncBtn.classList.remove('border-zinc-800', 'bg-zinc-900/60');
                desyncText.textContent = "Sync Feed";
                
                if (self.updateTimer) clearInterval(self.updateTimer);
                if (self.player) {
                  try { self.player.destroy(); } catch (e) {}
                  self.player = null;
                  self.currentVideoId = null;
                }
                
                self.startDesyncSequence();
              } else {
                desyncBtn.classList.remove('border-purple-500', 'text-purple-300', 'bg-purple-950/20');
                desyncBtn.classList.add('border-zinc-800', 'bg-zinc-900/60');
                desyncText.textContent = "Desync";
                
                if (self.desyncTimer) clearInterval(self.desyncTimer);
                self.currentVideoId = null;
                self.player = null;
                self.startLoop();
              }
            };
          }
        },

        floatCustomPip: function() {
          const viewport = document.getElementById('player-viewport');
          if (viewport) {
            viewport.classList.toggle('floating-pip-container');
          }
        },

        triggerPip: function() {
          const self = this;
          if (window !== window.parent) {
            window.parent.postMessage({
              type: 'cyber-player-toggle-pip',
              playlist: playlist,
              mediaType: type
            }, '*');
          } else {
            self.floatCustomPip();
          }
        },

        // Start Synchronized Broadcast Loop
        // WHY: The core feature of Cybernati is that all users visiting a playlist are watching the exact same video at the exact same timestamp.
        // It's a "live broadcast" simulation. We use the server-generated timeline and compare it against the current Unix time.
        startLoop: function() {
          const { totalLoopDuration, schedule, interstitials } = this.playlistData;
          if (!schedule || schedule.length === 0) return;
          
          const self = this;
          
          const update = () => {
            if (self.isDesynced) return;
            
            // WHY: By using Date.now() / 1000, we get the current Unix timestamp in seconds.
            // Using modulo (%) with the totalLoopDuration gives us the exact second within the loop that we should be at right now.
            // Since Unix time is the same across the globe, every single client computes the exact same `pos`.
            const now = Math.floor(Date.now() / 1000);
            const pos = now % totalLoopDuration;
            
            let active = null;
            let standby = true;
            let wait = 0;
            let offset = 0;
            let nextIndex = 0;
            
            // Find which video should be playing based on the current position `pos`
            for (let i = 0; i < schedule.length; i++) {
              const p = schedule[i];
              // If `pos` falls within the video's start and end times, it should be actively playing.
              if (pos >= p.start && pos < p.end) {
                active = p;
                standby = false;
                offset = pos - p.start; // Calculate how many seconds into the video we should seek to.
                nextIndex = (i + 1) % schedule.length;
                break;
              }
              // If `pos` is after this video, but before the next video starts (or we're at the end of the loop),
              // we are in a "standby" / interstitial gap.
              if (pos >= p.end && (i === schedule.length - 1 || pos < schedule[i+1].start)) {
                standby = true;
                wait = (i === schedule.length - 1) ? (totalLoopDuration - pos) : (schedule[i+1].start - pos);
                nextIndex = (i + 1) % schedule.length;
                break;
              }
            }
            
            const progressBar = document.getElementById('sync-progress');
            const titleEl = document.getElementById('video-title');
            const nextEl = document.getElementById('next-title');
            
            if (!standby && active) {
              if (progressBar) progressBar.style.width = `${((offset / active.duration) * 100)}%`;
              if (titleEl) titleEl.innerHTML = active.title.toUpperCase();
              if (nextEl) nextEl.innerHTML = schedule[nextIndex].title.toUpperCase();
              
              // Only load the YouTube iframe if the video ID has changed, to avoid reloading the iframe every second.
              if (self.currentVideoId !== active.id) {
                self.mountVideo(active, offset);
              } else if (self.player && self.player.getCurrentTime) {
                // WHY: Drift correction. If the client's player gets out of sync (due to buffering or lag),
                // we force it to seek to the mathematically correct timestamp if it drifts by more than 3 seconds.
                const drift = Math.abs(self.player.getCurrentTime() - offset);
                if (drift > 3) self.player.seekTo(offset, true);
              }
            } else {
              // During interstitial gaps, display a countdown / standby message.
              if (progressBar) progressBar.style.width = `${Math.min(100, (wait / 30) * 100)}%`;
              if (titleEl) titleEl.innerHTML = "SIGNAL LOST: TRANSMITTING STANDBY...";
              if (nextEl) nextEl.innerHTML = schedule[nextIndex].title.toUpperCase();
              
              self.mountStandby(interstitials);
            }
          };

          if (this.updateTimer) clearInterval(this.updateTimer);
          // Run the update logic every 1 second to keep the progress bar moving and correct for drift.
          this.updateTimer = setInterval(update, 1000);
          update();
        },

        // Start Desynchronized Mode (On-Demand shuffle)
        // WHY: Sometimes users don't want to watch the live broadcast, they just want to flip through random videos.
        // This stops the synchronized `updateTimer` and plays random clips from the playlist.
        startDesyncSequence: function() {
          const { schedule, interstitials } = this.playlistData;
          if (!schedule || schedule.length === 0) return;
          const self = this;
          
          const playRandom = () => {
            const index = Math.floor(Math.random() * schedule.length);
            const prog = schedule[index];
            
            // WHY: In desync mode, we don't want to play entire videos. We want it to feel like flipping channels.
            // We cap the play window to 5 minutes (300 seconds) max.
            // If the video is longer than 5 minutes, pick a random starting point. If shorter, play from the start.
            const playWindow = Math.min(prog.duration, 300);
            const startAt = prog.duration > 300 
              ? Math.floor(Math.random() * (prog.duration - playWindow)) 
              : 0;
            
            self.mountVideo(prog, startAt);
            
            let remaining = playWindow;
            
            if (self.desyncTimer) clearInterval(self.desyncTimer);
            self.desyncTimer = setInterval(() => {
              if (!self.isDesynced) {
                clearInterval(self.desyncTimer);
                return;
              }
              
              remaining--;
              
              const progressBar = document.getElementById('sync-progress');
              if (progressBar) {
                progressBar.style.width = `${((remaining / playWindow) * 100)}%`;
              }
              
              if (remaining <= 0) {
                clearInterval(self.desyncTimer);
                self.mountStandby(interstitials);
                
                // Keep standby interstitial running for 10 seconds before flipping to the next random clip
                setTimeout(playRandom, 10000);
              }
            }, 1000);
          };

          playRandom();
        },

        mountVideo: function(prog, offset) {
          const mount = document.getElementById('player-mount');
          if (!mount) return;
          
          if (this.currentVideoId === prog.id && this.player && this.player.getPlayerState && this.player.getPlayerState() > 0) return;
          
          if (this.player && this.player.destroy) {
            try { this.player.destroy(); } catch (e) {}
          }
          
          this.player = null;
          this.currentVideoId = prog.id;
          
          // Clear any interstitial cached index so that standby picks fresh
          this.currentInterstitialIndex = null;
          
          mount.innerHTML = '<div id="yt-player" class="h-full w-full"></div>';
          
          const self = this;
          this.player = new YT.Player('yt-player', {
            height: '100%',
            width: '100%',
            videoId: prog.id,
            playerVars: {
              autoplay: 1,
              mute: 1,
              controls: 0,
              disablekb: 1,
              modestbranding: 1,
              rel: 0,
              start: Math.floor(offset)
            },
            events: {
              onReady: (e) => {
                if (self.isMuted) {
                  e.target.mute();
                } else {
                  e.target.unMute();
                  e.target.setVolume(self.currentVolume);
                }
              },
              onError: (e) => {
                console.error("YouTube Player API Error:", e);
              }
            }
          });

          // Render dynamic related links in footer panel
          const linksEl = document.getElementById('related-links');
          if (linksEl) {
            if (prog.related && prog.related.length > 0) {
              linksEl.innerHTML = prog.related.map(link => {
                let linkSlug = link.slug;
                if (linkSlug.startsWith('/') && !linkSlug.startsWith(base)) {
                  const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
                  linkSlug = cleanBase + linkSlug;
                }
                return `
                  <a href="${linkSlug}" class="cyber-related-link px-3 py-1.5 rounded-lg text-xs font-semibold border border-zinc-800 bg-zinc-900 text-zinc-100 hover:border-purple-500 hover:text-purple-300 transition duration-150">
                    ${link.name}
                  </a>
                `;
              }).join('');
              
              // Intercept click on related links inside iframe to trigger PiP and navigate parent
              // WHY: Normally, clicking a link inside an iframe will navigate the iframe itself.
              // We want clicking a related note to navigate the MAIN site (the parent window),
              // while simultaneously popping the player into PiP mode so the user can keep watching while reading the note.
              linksEl.querySelectorAll('.cyber-related-link').forEach(linkEl => {
                linkEl.onclick = (e) => {
                  if (window !== window.parent) {
                    // Prevent the iframe from navigating
                    e.preventDefault();
                    
                    // Check if the parent window has already popped us out into PiP mode
                    // WHY: We reach across the boundary to check window.parent.cyberPlayerContainer.
                    // This only works because the iframe and the parent share the same origin (localhost or the same domain).
                    const isParentPipActive = window.parent.cyberPlayerContainer && 
                      window.parent.cyberPlayerContainer.classList.contains('floating-pip-iframe-container');
                    
                    // If we aren't in PiP mode yet, tell the parent to pop us out before navigating.
                    if (!isParentPipActive) {
                      self.triggerPip();
                    }
                    
                    // Tell parent window to navigate to the note using Swup
                    // WHY: If we just changed window.parent.location.href, the whole page would hard refresh and destroy the iframe.
                    // By posting a message, the parent's BaseLayout listener intercepts it and uses Swup.navigate(),
                    // which fetches the new page via AJAX and smoothly transitions the DOM WITHOUT destroying the floating iframe.
                    const href = linkEl.getAttribute('href');
                    window.parent.postMessage({
                      type: 'cyber-player-navigate',
                      url: href
                    }, '*');
                  }
                };
              });
            } else {
              linksEl.innerHTML = '<span class="text-xs text-zinc-500 uppercase italic">No related vault notes detected.</span>';
            }
          }
        },

        mountStandby: function(interstitials) {
          const mount = document.getElementById('player-mount');
          if (!mount || !interstitials || interstitials.length === 0) return;
          
          if (this.currentInterstitialIndex === null) {
            this.currentInterstitialIndex = Math.floor(Math.random() * interstitials.length);
          }
          
          let intUrl = interstitials[this.currentInterstitialIndex];
          if (intUrl.startsWith('/') && !intUrl.startsWith(base)) {
            const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
            intUrl = cleanBase + intUrl;
          }
          
          const existing = mount.querySelector('video');
          if (existing && existing.getAttribute('src') === intUrl) return;
          
          if (this.player && this.player.destroy) {
            try { this.player.destroy(); } catch (e) {}
            this.player = null;
            this.currentVideoId = null;
          }
          
          mount.innerHTML = `
            <video src="${intUrl}" autoplay muted loop style="width:100%; height:100%; object-fit:cover; background:black;"></video>
          `;
          
          // Clear dynamic related links in footer panel
          const linksEl = document.getElementById('related-links');
          if (linksEl) {
            linksEl.innerHTML = '<span class="text-xs text-zinc-500 uppercase italic">TRANSMITTING CYBERNATI SIGNAL INTERSTITIAL...</span>';
          }
        }
      };

      // Load YouTube IFrame API if not already present
      if (!window.YT) {
        const tag = document.createElement('script');
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);
      }
      
      const checkReady = setInterval(() => {
        if (window.YT && window.YT.Player && document.getElementById('player-mount')) {
          clearInterval(checkReady);
          window.CyberPlayer.init();
        }
      }, 500);
      // Listen for message instructions from the parent page
      window.addEventListener('message', (event) => {
        if (!event.data) return;
        
        if (event.data.type === 'cyber-player-enter-pip') {
          document.body.classList.add('pip-mode');
        } else if (event.data.type === 'cyber-player-exit-pip') {
          document.body.classList.remove('pip-mode');
        } else if (event.data.type === 'cyber-player-stop') {
          window.CyberPlayer.destroy();
        }
      });

    })();
  </script>
</body>
</html>
